---
import '../styles/global.css';
import {site,path} from '../site';
const {title=site.title,description=site.description,noindex=false} = Astro.props;
const canonical = new URL(Astro.url.pathname,Astro.site);
const nav=[['文章',''],['新闻站点','news/'],['归档','archive/'],['关于','about/']];
const activeNav = (url) => url === 'news/' ? Astro.url.pathname.startsWith(path('news/')) : Astro.url.pathname === path(url);
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#204fe7"/><title>{title}</title><meta name="description" content={description}/>{noindex&&<meta name="robots" content="noindex"/>}<link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" href={path('favicon.svg')}/><link rel="alternate" type="application/rss+xml" title={site.title} href={path('rss.xml')}/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script></head><body>
<a class="skip" href="#main">跳到正文</a><header class="header"><a class="brand" href={path()}><span class="mark" aria-hidden="true">H</span><span>{site.name}<small>工程与思考</small></span></a><nav aria-label="主导航">{nav.map(([label,url])=><a class:list={{active:activeNav(url)}} aria-current={activeNav(url) ? 'page' : undefined} href={path(url)}>{label}</a>)}</nav><div class="header-tools"><a class="icon-button" href={path('search/')} aria-label="搜索文章"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></a><button class="icon-button" id="theme" aria-label="切换深浅色"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 13a8 8 0 0 1-9-9A8 8 0 1 0 20 13Z"/></svg></button></div></header>
<main id="main"><slot/></main><footer><div><strong>{site.name}</strong><p>把思考留下来，把事情做出来。</p></div><div class="footer-links"><a href={path('news/')}>新闻站点</a><a href={path('archive/')}>全部文章</a><a href={path('rss.xml')}>RSS 订阅</a>{Object.entries(site.social).filter(([,v])=>v).map(([k,v])=><a href={v} target="_blank" rel="noopener noreferrer">{{github:'GitHub',zhihu:'知乎',bilibili:'B站',wechat:'微信公众号'}[k]}</a>)}</div><small>© {new Date().getFullYear()} {site.name}</small></footer>
<script>document.querySelector('#theme')?.addEventListener('click',()=>{const t=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=t;try{localStorage.setItem('theme',t)}catch{}})</script>
</body></html>
