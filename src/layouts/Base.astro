---
import '../styles/global.css';
import '../styles/notebook.css';
import Analytics from '../components/Analytics.astro';
import {site,path} from '../site';
const {title=site.title,description=site.description,noindex=false,wide=false} = Astro.props;
const canonical = new URL(Astro.url.pathname,Astro.site);
const nav=[['首页',''],['新闻站点','news/'],['归档','archive/'],['关于','about/']];
const activeNav = (url) => url === 'news/' ? Astro.url.pathname.startsWith(path('news/')) : Astro.url.pathname === path(url);
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f8f8f7"/><title>{title}</title><meta name="description" content={description}/>{noindex&&<meta name="robots" content="noindex"/>}<link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="icon" href={path('favicon.svg')}/><link rel="alternate" type="application/rss+xml" title={site.title} href={path('rss.xml')}/><link rel="alternate" type="application/rss+xml" title="海波东的新闻日刊" href={path('news/rss.xml')}/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script></head><body class:list={{'wide-layout':wide}}>
<a class="skip" href="#main">跳到正文</a>
<header class="header"><a class="brand" href={path()} aria-label="海波东，返回首页"><svg class="brand-symbol" viewBox="0 0 28 28" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M3 17c4-5 6 5 11 0s7 5 11 0M4 22c4-5 6 4 10 0s7 4 10 0M8 11l6-8 5 8H8Z"/></svg><span>海波东</span></a><nav aria-label="主导航">{nav.map(([label,url])=><a class:list={{active:activeNav(url)}} aria-current={activeNav(url)?'page':undefined} href={path(url)}>{label}</a>)}</nav><div class="header-tools"><a class="icon-button" href={path('search/')} aria-label="搜索文章"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></a><button class="icon-button" id="theme" aria-label="切换深浅色"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 13a8 8 0 0 1-9-9A8 8 0 1 0 20 13Z"/></svg></button></div></header>
<main id="main"><slot/></main>
<footer><div class="footer-main"><a class="footer-signature" href={path()}>海波东</a><p>写下来，也做出来。</p></div><div class="footer-links"><a href={path('news/')}>新闻站点</a><a href={path('rss.xml')} data-track="subscribe" data-feed="articles">订阅文章</a><a href={path('stats/')}>数据仪表盘</a><a href={site.social.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div><div class="footer-bottom"><small>© {new Date().getFullYear()} 海波东</small><a href={path('privacy/')}>隐私说明</a><span>慢慢更新，认真记录。</span></div></footer>
<Analytics/>
<script>
import '../scripts/engagement';
document.querySelectorAll<HTMLImageElement>('.note-image img,.news-cover img').forEach(img=>{const fallback=()=>{const figure=img.closest<HTMLElement>('.note-image,.news-cover');if(figure)figure.hidden=true};img.addEventListener('error',fallback);if(img.complete&&!img.naturalWidth)fallback()});
const themeButton=document.querySelector<HTMLButtonElement>('#theme');
const reflectTheme=()=>themeButton?.setAttribute('aria-pressed',String(document.documentElement.dataset.theme==='dark'));
reflectTheme();themeButton?.addEventListener('click',()=>{const t=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=t;try{localStorage.setItem('theme',t)}catch{}reflectTheme()});
</script>
</body></html>
