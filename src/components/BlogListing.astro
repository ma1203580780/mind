---
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import {path} from '../site';
import {blogCategories,blogCategoryRoute} from '../lib/blog-categories';
const {posts,title='博客',category,years=[]}=Astro.props;
const rootArchive=Astro.url.pathname===path('archive/');
---
<Base title={`${title} · 海波东`} blogCategory={category} blogArchive={rootArchive}>
<div class:list={{'archive-canvas':rootArchive}}>
<section class:list={['archive blog-home',{'archive-content':rootArchive}]}>
  {rootArchive?<h1 class="sr-only">{title}</h1>:<header class="archive-heading"><h1>{title}</h1></header>}
  {!rootArchive&&<nav class="blog-categories" aria-label="博客分类">{blogCategories.map(item=><a href={path(blogCategoryRoute(item.name))} aria-current={item.name===category?'page':undefined}>{item.name}</a>)}</nav>}
  {posts.length>0?<div class="blog-grid">{posts.map(post=><PostCard post={post}/>)}</div>:<p class="collection-note">暂无文章。</p>}
  {years.length>0&&<details class="blog-years"><summary>按年份归档</summary><nav aria-label="博客年份归档">{years.map(year=><a href={path(`archive/year/${year}/`)}>{year}</a>)}</nav></details>}
</section>
</div>
</Base>
<style>
.blog-categories{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 24px}.blog-categories a{padding:6px 12px;border-radius:12px;font-size:12px;background:var(--soft);color:var(--blue)}.blog-categories a[aria-current=page]{background:var(--paper);box-shadow:var(--shadow)}.blog-years{margin-top:36px;color:var(--muted);font-size:12px}.blog-years summary{cursor:pointer}.blog-years nav{display:flex;gap:20px;flex-wrap:wrap;padding:16px 0}.blog-years a:hover{color:var(--ink)}
</style>
