---
// 公共顶栏：品牌 + 主导航 tab + 主题开关。
// 所有页面共用一份；页面自己不要写 header，也不要按页面覆盖这里的样式。
import {path, site} from '../site';
import {PRIMARY_TABS} from '../lib/site-chrome.mjs';
const {section} = Astro.props;
---
<header id="site-header" class="site-header" transition:persist="site-header" transition:name="site-header"><div class="header-inner"><a class="brand" href={path()} aria-label={`${site.title}，返回首页`}><svg class="brand-symbol" viewBox="0 0 28 28" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M3 17c4-5 6 5 11 0s7 5 11 0M4 22c4-5 6 4 10 0s7 4 10 0M8 11l6-8 5 8H8Z"/></svg><span>{site.name}</span></a><nav aria-label="主导航">{PRIMARY_TABS.map(tab=><a data-section={tab.section} class:list={{active:section===tab.section}} aria-current={section===tab.section?'page':undefined} href={path(tab.url)}>{tab.label}</a>)}</nav><div class="header-tools"><button class="icon-button" id="theme" aria-label="切换深浅色"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 13a8 8 0 0 1-9-9A8 8 0 1 0 20 13Z"/></svg></button></div></div></header>
