---
const {kind} = Astro.props;
---
<div class="lab-project-visual" aria-hidden="true">
  {kind === 'mind' ? <svg viewBox="0 0 520 340" fill="none" focusable="false">
    <defs>
      <radialGradient id="mind-core" cx=".3" cy=".2" r=".85"><stop stop-color="#fcffff"/><stop offset=".36" stop-color="#d5e8ed"/><stop offset=".7" stop-color="#9bb9c7"/><stop offset="1" stop-color="#506e86"/></radialGradient>
      <linearGradient id="mind-orbit" x1="115" y1="235" x2="397" y2="105" gradientUnits="userSpaceOnUse"><stop stop-color="#7892b1"/><stop offset=".4" stop-color="#efffff"/><stop offset=".67" stop-color="#98cdd5"/><stop offset="1" stop-color="#557188"/></linearGradient>
      <linearGradient id="mind-glass" x1="192" y1="93" x2="317" y2="229" gradientUnits="userSpaceOnUse"><stop stop-color="white" stop-opacity=".9"/><stop offset="1" stop-color="white" stop-opacity="0"/></linearGradient>
      <filter id="mind-shadow" x="-50%" y="-150%" width="200%" height="400%"><feGaussianBlur stdDeviation="10"/></filter>
      <filter id="mind-glow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="5"/></filter>
    </defs>
    <ellipse class="lab-art-shadow" cx="265" cy="286" rx="100" ry="10" fill="#29475d" filter="url(#mind-shadow)"/>
    <g class="lab-art-guides" stroke="currentColor" stroke-width=".7">
      <ellipse cx="260" cy="280" rx="163" ry="27"/><path d="M78 280h22m321 0h22M260 309v9M260 44v13"/>
      <circle cx="260" cy="164" r="123" stroke-dasharray="2 9"/>
    </g>
    <g class="lab-art-object">
      <ellipse cx="260" cy="166" rx="155" ry="48" transform="rotate(-24 260 166)" stroke="url(#mind-orbit)" stroke-width="1.6" opacity=".65"/>
      <ellipse cx="260" cy="166" rx="115" ry="42" transform="rotate(54 260 166)" stroke="#9fb6c9" stroke-width=".7" opacity=".4"/>
      <circle cx="260" cy="164" r="80" fill="url(#mind-core)"/><circle cx="260" cy="164" r="79.5" stroke="url(#mind-glass)"/>
      <g stroke="#f2ffff" stroke-width=".7" opacity=".44">
        <ellipse cx="260" cy="164" rx="40" ry="79" transform="rotate(-24 260 164)"/>
        <ellipse cx="260" cy="164" rx="67" ry="79" transform="rotate(-24 260 164)"/>
        <ellipse cx="260" cy="164" rx="79" ry="27" transform="rotate(-24 260 164)"/>
        <ellipse cx="260" cy="164" rx="79" ry="57" transform="rotate(-24 260 164)"/>
      </g>
      <path d="M118.4 229c10.8 24.3 83 17 161.4-17.9s133.4-84.2 122.6-108.5" stroke="url(#mind-orbit)" stroke-width="3" stroke-linecap="round"/>
      <path d="M126 235c24 14 89-1 155-30" stroke="#f0ffff" stroke-width=".7" stroke-linecap="round" opacity=".85"/>
      <circle cx="386" cy="128" r="9" fill="#a6d9e3" opacity=".6" filter="url(#mind-glow)"/>
      <circle cx="386" cy="128" r="4.3" fill="#efffff" stroke="#89b3c4" stroke-width="1"/><circle cx="197" cy="190" r="2" fill="#eaffff"/>
    </g>
  </svg> : kind === 'kancloud' ? <svg viewBox="0 0 520 340" fill="none" focusable="false">
    <defs>
      <linearGradient id="kancloud-page" x1="140" y1="85" x2="318" y2="257" gradientUnits="userSpaceOnUse"><stop stop-color="#fff"/><stop offset=".5" stop-color="#e8f4ee"/><stop offset="1" stop-color="#a4c3b6"/></linearGradient>
      <linearGradient id="kancloud-edge" x1="90" y1="174" x2="337" y2="242" gradientUnits="userSpaceOnUse"><stop stop-color="#c5ded3"/><stop offset=".6" stop-color="#8eafa0"/><stop offset="1" stop-color="#a1c3b4"/></linearGradient>
      <linearGradient id="kancloud-glass" x1="168" y1="113" x2="299" y2="226" gradientUnits="userSpaceOnUse"><stop stop-color="#f6fcf9" stop-opacity=".7"/><stop offset="1" stop-color="#a6c8b8" stop-opacity=".12"/></linearGradient>
      <filter id="kancloud-shadow" x="-50%" y="-150%" width="200%" height="400%"><feGaussianBlur stdDeviation="11"/></filter>
    </defs>
    <ellipse class="lab-art-shadow" cx="260" cy="291" rx="101" ry="11" fill="#34594c" filter="url(#kancloud-shadow)"/>
    <g class="lab-art-guides" stroke="currentColor" stroke-width=".7">
      <ellipse cx="260" cy="285" rx="164" ry="27"/><path d="M79 285h21m321 0h21M260 313v9M260 49v13"/>
      <path d="m106 170 153-98 154 98-153 99Z" stroke-dasharray="2 9"/>
    </g>
    <g class="lab-art-object">
      <path d="m110 198 99-92 200 61-99 94Z" fill="url(#kancloud-glass)" stroke="#bad8ca" stroke-opacity=".7"/>
      <path d="m110 198 200 63 99-94v7l-99 94-200-63Z" fill="url(#kancloud-edge)" opacity=".5"/>
      <path d="m104 175 99-92 200 61-99 94Z" fill="url(#kancloud-page)" fill-opacity=".55" stroke="#d9eae2"/>
      <path d="m104 175 200 63 99-94v6l-99 94-200-63Z" fill="url(#kancloud-edge)" opacity=".75"/>
      <path d="m98 150 99-92 200 61-99 94Z" fill="url(#kancloud-page)" stroke="#f7fcf9" stroke-width="1.1"/>
      <path d="m98 150 200 63 99-94v5l-99 94-200-63Z" fill="url(#kancloud-edge)"/>
      <path d="m175 108 119 37" stroke="#91b09f" stroke-width="4" stroke-linecap="round" opacity=".85"/>
      <path d="m162 123 95 29m-108-15 135 42m-148-28 103 32" stroke="#9bb9aa" stroke-width="2.5" stroke-linecap="round" opacity=".6"/>
      <path d="m197 58 200 61-34-10-15 15 33 10 16-15" fill="white" fill-opacity=".22" stroke="white" stroke-opacity=".5" stroke-width=".7"/>
      <path d="m183 86 18-16 38 11" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
      <circle cx="369" cy="217" r="3" fill="#bbd8c9"/>
    </g>
  </svg> : kind === 'sre-course' && <svg viewBox="0 0 520 340" fill="none" focusable="false">
    <defs>
      <linearGradient id="sre-screen" x1="142" y1="83" x2="374" y2="248" gradientUnits="userSpaceOnUse"><stop stop-color="#fffef8"/><stop offset=".55" stop-color="#eee8d8"/><stop offset="1" stop-color="#c3b795"/></linearGradient>
      <linearGradient id="sre-rim" x1="126" y1="201" x2="385" y2="241" gradientUnits="userSpaceOnUse"><stop stop-color="#d6c9a7"/><stop offset=".6" stop-color="#8e8874"/><stop offset="1" stop-color="#b6ab8e"/></linearGradient>
      <linearGradient id="sre-shield" x1="227" y1="102" x2="293" y2="216" gradientUnits="userSpaceOnUse"><stop stop-color="#fffefb"/><stop offset="1" stop-color="#d4cbb2"/></linearGradient>
      <filter id="sre-shadow" x="-50%" y="-150%" width="200%" height="400%"><feGaussianBlur stdDeviation="10"/></filter>
    </defs>
    <ellipse class="lab-art-shadow" cx="260" cy="286" rx="104" ry="10" fill="#5d5333" filter="url(#sre-shadow)"/>
    <g class="lab-art-guides" stroke="currentColor" stroke-width=".7">
      <ellipse cx="260" cy="281" rx="163" ry="27"/><path d="M78 281h22m321 0h22M260 309v9M260 45v13"/>
      <path d="M100 144v-52a25 25 0 0 1 25-25h270a25 25 0 0 1 25 25v123" stroke-dasharray="2 9"/>
    </g>
    <g class="lab-art-object">
      <rect x="124" y="96" width="272" height="159" rx="20" fill="url(#sre-rim)"/>
      <rect x="124" y="82" width="272" height="165" rx="20" fill="url(#sre-screen)" stroke="#fffff8" stroke-width="1"/>
      <rect x="139" y="97" width="242" height="134" rx="11" stroke="#bdb292" stroke-opacity=".45"/>
      <g stroke="#9d957f" stroke-width="1" opacity=".45">
        <path d="M155 137h31l14 14h23m77 16h30l15-15h20M155 195h27l16-16h23m90 22h31l12 12"/>
        <circle cx="155" cy="137" r="3"/><circle cx="365" cy="152" r="3"/><circle cx="155" cy="195" r="3"/>
      </g>
      <path d="M260 106c18 12 35 16 48 19v36c0 29-20 48-48 62-28-14-48-33-48-62v-36c13-3 30-7 48-19Z" fill="#a99f82" opacity=".3" transform="translate(0 5)"/>
      <path d="M260 101c18 12 35 16 48 19v36c0 29-20 48-48 62-28-14-48-33-48-62v-36c13-3 30-7 48-19Z" fill="url(#sre-shield)" stroke="#fffef8" stroke-width="1.5"/>
      <path d="m240 157 14 14 29-31" stroke="#8d9b8a" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M221 131v25c0 20 13 37 39 51" stroke="white" stroke-opacity=".65" stroke-width="1.1" stroke-linecap="round"/>
      <path d="M149 88h69" stroke="white" stroke-opacity=".85" stroke-linecap="round"/>
      <circle cx="363" cy="114" r="3" fill="#a9baa6"/>
    </g>
  </svg>}
</div>
