---
import Base from '../layouts/Base.astro';
import '../styles/reading-kit/index.css';
import '../styles/reading-kit/site-adapter.css';
import {path} from '../site';
const {article,post}=Astro.props;
const html=article.html.replaceAll('__BASE__',path());
---
<Base title={`${article.title} · 海波东`} description={article.description} reading ogType="article" publishedTime={post.data.date.toISOString()}>
  <Fragment set:html={html} />
</Base>
<script>
import '../scripts/editorial-reader.js';
</script>
