---
import {statusLabels} from '../lib/connections';
import {githubProjects} from '../lib/projects';
const {project}=Astro.props;
const repo=githubProjects.find(r=>r.url===project.github);
---
<article class="project-card" id={project.id}>
 <div class="status" data-status={project.status}><span aria-hidden="true"></span>{statusLabels[project.status]}</div>
 <h2>{project.name}</h2><p>{project.description}</p>
 <div class="project-progress"><small>当前进展</small><p>{project.progress}</p></div>
 <div class="interest-tags tech-tags">{project.stack.map(t=><span>{t}</span>)}</div>
 <div class="project-facts">{project.updatedAt&&<time datetime={project.updatedAt}>进展更新 {project.updatedAt}</time>}{repo&&<span>☆ {repo.stars} · {repo.forks} Fork · {repo.language} · 仓库更新 {repo.updatedAt.slice(0,10)}</span>}</div>
 <a class="text-link" href={project.github||project.url} target="_blank" rel="noopener noreferrer" data-connection-event={project.github?'project_github_click':undefined}>{project.github?'GitHub':'阅读专栏'} ↗</a>
</article>
