---
import {sourceHost,displayTitle,displaySummary,sourceLanguage,type NewsStory} from '../lib/news';
const {story,issue,index=9}=Astro.props as {story:NewsStory;issue:string;index?:number};
const english=sourceLanguage(story)==='en';const translated=!!story.titleZh;const readerId=`reader-${story.id}`;
---
<article class="news-card" id={story.id} data-category={story.category} data-language={sourceLanguage(story)} data-search={`${displayTitle(story)} ${displaySummary(story)} ${story.title} ${story.summary} ${story.sourceName} ${story.category}`.toLowerCase()}>
  {story.image&&<figure class="news-figure"><button class="news-cover reader-trigger" type="button" data-reader={readerId} aria-label={`阅读：${displayTitle(story)}`}><img src={story.image} alt={story.imageAlt||'原文配图'} loading={index<4?'eager':'lazy'} decoding="async" referrerpolicy="no-referrer"/></button><figcaption>{story.imageKind||'原文配图'} · {story.sourceName}</figcaption></figure>}
  <div class="news-card-body"><div class="card-top"><span>{story.category}</span><span class="language-dot">{english?'英文源':'中文源'}</span></div>
  <h2><button class="headline-button reader-trigger" type="button" data-reader={readerId}>{displayTitle(story)}</button></h2>
  <p class="story-summary">{displaySummary(story)}</p>
  <div class="story-labels"><span>{story.kind}</span>{translated&&<span>中文机译</span>}<time datetime={story.publishedDate}>{story.publishedDate.slice(5).replace('-','.')}</time></div>
  <div class="card-reading-actions"><button class="reader-trigger" type="button" data-reader={readerId}>{translated?'中英对照':'展开阅读'} <span aria-hidden="true">↗</span></button><a href={story.sourceUrl} target="_blank" rel="noopener noreferrer" data-track="news_source_open" data-story={story.id} data-source={sourceHost(story.sourceUrl)} data-category={story.category} data-issue={issue}>原文 ↗</a></div>
  <div class="card-publisher">{story.sourceName}</div>
  </div>
</article>
<dialog class="news-reader" id={readerId} aria-labelledby={`reader-title-${story.id}`}>
  <div class="reader-top"><div><span>{story.category} · {story.kind}</span><p>{english?'英文来源':'中文来源'} / {story.sourceName}</p></div><button type="button" class="reader-close" aria-label="关闭阅读" data-close-reader>×</button></div>
  <div class="reader-scroll">
    <h2 id={`reader-title-${story.id}`}>{displayTitle(story)}</h2>
    <div class="reader-meta"><time datetime={story.publishedAt||story.publishedDate}>发布 {story.publishedDate}</time>{story.author&&<span>作者 {story.author}</span>}{translated&&<span class="translation-badge">免费离线机译</span>}</div>
    {story.image&&<figure class="reader-image"><img src={story.image} alt={story.imageAlt||'原文配图'} loading="lazy" referrerpolicy="no-referrer"/><figcaption>{story.imageKind||'原文配图'} · <a href={story.imageSourceUrl||story.sourceUrl} target="_blank" rel="noopener noreferrer">查看图片出处 ↗</a></figcaption></figure>}
    <div class:list={['reader-columns',{'is-bilingual':translated}]}>
      <section class="reader-chinese"><h3>{translated?'中文译文':'内容摘读'}</h3><p>{displaySummary(story)}</p></section>
      {translated&&<section class="reader-original" lang="en"><h3>英文原文</h3><h4>{story.title}</h4><p>{story.summary}</p></section>}
    </div>
    {story.summaryTruncated&&<p class="reader-note">以上为原文摘要节选，完整论证、数据与条件请阅读发布者原文。</p>}
    {english&&!translated&&story.contentLanguage==='en'&&<p class="reader-note">本条译文暂不可用，保留原文供查阅。</p>}
    {!story.automated&&<section class="reader-commentary"><h3>编辑判断</h3><p>{story.why}</p><p>{story.action}</p></section>}
    <details class="reader-provenance"><summary>来源与采集记录</summary><p>{story.automated?'公开订阅源自动收录。':'编辑摘读。'}{translated?'机译用于辅助阅读，术语与数字请对照原文。':''}</p>{story.fetchedAt&&<p>采集 {new Date(story.fetchedAt).toLocaleString('zh-CN',{timeZone:'Asia/Shanghai'})}（北京时间）</p>}{story.feedUrl&&<a href={story.feedUrl} target="_blank" rel="noopener noreferrer">原始 RSS / Atom ↗</a>}{story.translationProvider&&<p>翻译：{story.translationProvider}</p>}</details>
  </div>
  <div class="reader-footer"><small>{translated?'中文辅助阅读 · 英文原文可核对':'摘要节选 · 完整内容见原文'}</small><a href={story.sourceUrl} target="_blank" rel="noopener noreferrer" data-track="news_source_open" data-story={story.id} data-source={sourceHost(story.sourceUrl)} data-category={story.category} data-issue={issue}>阅读发布者原文 ↗</a></div>
</dialog>
