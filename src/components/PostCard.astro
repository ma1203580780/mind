---
import {path,dateLabel,reading} from '../site';
const {post}=Astro.props;
const cover=post.data.cover;
---
<article class:list={['note-card',{'has-source-cover':!!cover}]}>
{cover&&<figure class="note-image"><a href={path(`posts/${post.id}/`)} tabindex="-1" aria-hidden="true"><img src={cover.src} alt={cover.alt} loading="lazy" decoding="async"/></a><figcaption><a href={cover.sourceUrl} target="_blank" rel="noopener noreferrer">图片：{cover.sourceName} ↗</a></figcaption></figure>}
<div class="note-content"><div class="note-meta"><span>{post.data.category}</span>{post.data.demo&&<span class="note-draft">示例稿</span>}</div><h2><a href={path(`posts/${post.id}/`)}>{post.data.title}</a></h2><p class="note-excerpt">{post.data.description}</p><div class="note-byline"><span>海波东</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date).slice(5)}</time></div><div class="note-actions"><span>{reading(post.body)} 分钟</span><div aria-label="文章消费方式"><a href={path(`posts/${post.id}/`)} aria-label={`阅读：${post.data.title}`}>读</a><a href={path(`posts/${post.id}/?mode=audio`)} aria-label={`收听：${post.data.title}`}>听</a><a href={path(`posts/${post.id}/?mode=video`)} aria-label={`观看：${post.data.title}`}>看</a></div></div></div>
</article>
