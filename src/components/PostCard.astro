---
import {path,dateLabel,reading} from '../site';
const {post,index=0} = Astro.props;
---
<article class="post-row"><div class="post-number">{String(index+1).padStart(2,'0')}</div><div class="post-main"><div class="meta"><span class="category">{post.data.category}</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>{reading(post.body)} 分钟阅读</span>{post.data.demo&&<span class="demo-label">示例稿</span>}</div><h2><a href={path(`posts/${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag=><a href={path(`tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}</div></div></article>
