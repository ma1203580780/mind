---
import Base from '../layouts/Base.astro';
import { path } from '../site';
import { issues, newsDate, sourceHost, type NewsIssue } from '../lib/news';
import '../styles/news.css';
const { issue, archive = false } = Astro.props as { issue: NewsIssue; archive?: boolean };
const categories = [...new Set(issue.stories.map(s => s.category))];
const sourceCount = new Set(issue.stories.map(s => sourceHost(s.sourceUrl))).size;
const reviewed = new Intl.DateTimeFormat('zh-CN', {timeZone:'Asia/Shanghai',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(issue.checkedAt));
---
<Base title={`${newsDate(issue.date)} 新闻日刊 · 海波东`} description={issue.intro} wide>
<div class="news-workspace" data-issue-date={issue.date} data-checked-at={issue.checkedAt} data-archive={String(archive)}>
  <aside class="daily-sidebar">
    <a class="daily-wordmark" href={path('news/')}>海波东的日刊<span>每天，看看新东西。</span></a>
    <p class="sidebar-intro">AI、工程、产品与创作。<br/>精选值得读的消息，<br/>也保留自己的判断。</p>
    <a class="sidebar-back" href={path()}>回到个人博客 ↗</a>
    <details class="date-picker" open><summary>按日期翻阅 <span aria-hidden="true">⌄</span></summary><nav class="news-dates" aria-label="新闻日期">{issues.slice(0,14).map(i=><a href={path(`news/${i.date}/`)} aria-current={i.date===issue.date?'page':undefined} class:list={{chosen:i.date===issue.date}}><time datetime={i.date}>{Number(i.date.slice(5,7))}月{Number(i.date.slice(8))}日</time><span>{i.stories.length}</span></a>)}<a href={path('news/archive/')}>更多日期 ↗</a></nav></details>
    <div class="sidebar-bottom"><p>AI 整理 · 原始来源可查<br/>{reviewed} 核验（北京时间）</p><div class="sidebar-actions"><a href={path('news/rss.xml')}>订阅 RSS ↗</a><a href="https://github.com/ma1203580780/mind/issues" target="_blank" rel="noopener noreferrer">纠错 ↗</a></div><a class="editorial-link" href="https://github.com/ma1203580780/mind/blob/main/docs/NEWS_EDITORIAL.md" target="_blank" rel="noopener noreferrer">编辑规则 ↗</a></div>
  </aside>
  <section class="daily-board" aria-labelledby="news-title">
    <div class="daily-board-top"><div><h1 id="news-title">{archive?'往期摘读':'最新摘读'} <span>{newsDate(issue.date)}</span></h1><p>{issue.stories.length} 条精选 / {sourceCount} 个来源站点</p></div><div class="news-toolbar" data-news-controls hidden><label class="news-search"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input id="news-query" type="search" placeholder="搜索本期" aria-label="搜索本期新闻" autocomplete="off"/></label><div class="news-view" role="group" aria-label="新闻展示方式"><button type="button" data-view="cards" aria-pressed="true">图文</button><button type="button" data-view="list" aria-pressed="false">紧凑</button></div></div></div>
    <p class="news-stale" id="news-stale" hidden>新的内容尚未发布，以下为最近一次核验的内容。本期距今已超过 36 小时。</p>
    <p class="news-result" id="news-result" aria-live="polite" hidden></p>
    <div class="news-grid" id="news-grid" data-view="cards">
      {issue.stories.map((story,index)=><article class="news-card" id={story.id} data-category={story.category} data-search={`${story.title} ${story.summary} ${story.why} ${story.sourceName} ${story.category}`.toLowerCase()}>
        {story.image&&<a class="news-cover" href={story.sourceUrl} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"><img src={story.image} alt={story.imageAlt||''} loading={index<3?'eager':'lazy'} decoding="async" referrerpolicy="no-referrer"/></a>}{story.image&&<p class="source-image-credit">原图 · {story.sourceName}</p>}
        <div class="news-card-body"><div class="card-top"><span>{story.category}</span><span>·</span><span>{sourceHost(story.sourceUrl)}</span></div><h2><a href={story.sourceUrl} target="_blank" rel="noopener noreferrer" data-track="news_source_open" data-story={story.id} data-source={sourceHost(story.sourceUrl)} data-category={story.category} data-issue={issue.date}>{story.title}</a></h2><p class="story-summary">{story.summary}</p><div class="story-labels"><span>{story.kind}</span><time datetime={story.publishedDate}>{story.publishedDate.slice(5).replace('-','.')}</time></div><details class="story-detail"><summary>为什么值得看 <span aria-hidden="true">＋</span></summary><div class="story-insight"><span>编辑判断</span><p>{story.why}</p><span>可以做的一件事</span><p>{story.action}</p><a href={story.sourceUrl} target="_blank" rel="noopener noreferrer" data-track="news_source_open" data-story={story.id} data-source={sourceHost(story.sourceUrl)} data-category={story.category} data-issue={issue.date}>{story.sourceName} · 阅读原文 ↗</a></div></details>{story.updateOf&&<p class="story-update">后续进展 · <a href={path(`news/${story.updateOf.split('#')[0]}/#${story.updateOf.split('#')[1]}`)}>此前报道 ↗</a></p>}</div>
      </article>)}
      <article class="brief-card"><div class="brief-card-top"><span>本期看点</span><time datetime={issue.date}>{issue.date.slice(5).replace('-','月')}日</time></div><h2>{issue.title}</h2><p>{issue.intro}</p><ol>{issue.briefing.map((line,i)=><li><span>0{i+1}</span>{line}</li>)}</ol><div class="brief-tags" aria-label="本期主题">{categories.map(c=><span>{c}</span>)}</div><small>摘要由 AI 整理，完整条件请查原文。</small></article>
    </div>
    <div class="news-empty" id="news-empty" hidden><h2>本期没有匹配内容</h2><p>换个关键词，或清除筛选。</p><button type="button" id="news-reset">显示全部新闻</button></div>
    <div class="news-dock" data-news-controls hidden><div class="news-categories" role="group" aria-label="筛选新闻分类"><button type="button" class="chosen" data-category="全部" aria-pressed="true">全部</button>{categories.map(c=><button type="button" data-category={c} aria-pressed="false">{c}</button>)}</div></div>
  </section>
</div>
  <script>
    import {track} from '../scripts/analytics';
    document.querySelectorAll<HTMLImageElement>('.news-cover img').forEach(img=>{const hide=()=>{const link=img.closest<HTMLElement>('.news-cover');if(link)link.hidden=true;};img.addEventListener('error',hide);if(img.complete&&!img.naturalWidth)hide();});
    const picker=document.querySelector<HTMLDetailsElement>('.date-picker');if(picker&&matchMedia('(max-width: 850px)').matches)picker.open=false;
    const page = document.querySelector<HTMLElement>('.news-workspace');
    const grid = document.querySelector<HTMLElement>('#news-grid');
    if (page && grid) {
      document.querySelectorAll<HTMLElement>('[data-news-controls]').forEach(el=>el.hidden=false);
      const cards = [...grid.querySelectorAll<HTMLElement>('.news-card')];
      const input = document.querySelector<HTMLInputElement>('#news-query')!;
      const categories = [...document.querySelectorAll<HTMLButtonElement>('button[data-category]')];
      const result = document.querySelector<HTMLElement>('#news-result')!;
      let category = '全部';
      const filter = () => {
        const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        let count = 0;
        for (const card of cards) {
          const match = (category === '全部' || card.dataset.category === category) && words.every(w => card.dataset.search!.includes(w));
          card.hidden = !match; if (match) count++;
        }
        document.querySelector<HTMLElement>('.brief-card')!.hidden = category !== '全部' || words.length > 0;
        result.hidden = !words.length && category === '全部';
        result.textContent = `找到 ${count} 条内容`;
        document.querySelector<HTMLElement>('#news-empty')!.hidden = count > 0;
      };
      categories.forEach(button => button.addEventListener('click', () => {
        category = button.dataset.category!;track('news_filter',{category});
        categories.forEach(b => {b.classList.toggle('chosen', b === button);b.setAttribute('aria-pressed', String(b === button));});filter();
      }));
      input.addEventListener('input', filter);
      let searchTimer: ReturnType<typeof setTimeout>;input.addEventListener('input',()=>{clearTimeout(searchTimer);searchTimer=setTimeout(()=>{if(input.value.trim())track('search_used',{area:'news',results:cards.filter(c=>!c.hidden).length})},1200)});
      document.querySelector('#news-reset')?.addEventListener('click', () => {input.value = '';categories[0].click();input.focus();});
      const views = [...document.querySelectorAll<HTMLButtonElement>('button[data-view]')];
      const setView = (view: string) => {grid.dataset.view = view === 'list' ? 'list' : 'cards';views.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.view === grid.dataset.view)));};
      try {setView(localStorage.getItem('news-view') || 'cards');} catch {}
      views.forEach(b => b.addEventListener('click', () => {setView(b.dataset.view!);track('news_view',{view:grid.dataset.view!});try {localStorage.setItem('news-view', grid.dataset.view!);} catch {}}));
      if (page.dataset.archive !== 'true' && Date.now() - Date.parse(page.dataset.checkedAt!) > 36 * 60 * 60 * 1000) document.querySelector<HTMLElement>('#news-stale')!.hidden = false;
    }
  </script>
</Base>
