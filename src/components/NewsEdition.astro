---
import Base from '../layouts/Base.astro';
import NewsCard from './NewsCard.astro';
import {path} from '../site';
import {issues,newsDate,sourceHost,sourceLanguage,type NewsIssue} from '../lib/news';
import '../styles/news.css';
import '../styles/news-reader.css';
const {issue,archive=false}=Astro.props as {issue:NewsIssue;archive?:boolean};
const categories=[...new Set(issue.stories.map(s=>s.category))];
const sourceCount=new Set(issue.stories.map(s=>sourceHost(s.sourceUrl))).size;
const zhCount=issue.stories.filter(s=>sourceLanguage(s)==='zh').length;
const enCount=issue.stories.length-zhCount;
// Alternate original-image cards and text cards, with newest items within each group.
const sorted=[...issue.stories].sort((a,b)=>b.publishedDate.localeCompare(a.publishedDate));
const pictured=sorted.filter(s=>s.image),text=sorted.filter(s=>!s.image),stories=[];
while(pictured.length||text.length){if(pictured.length)stories.push(pictured.shift()!);if(text.length)stories.push(text.shift()!);}
const reviewed=new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(issue.checkedAt));
---
<Base title={`${newsDate(issue.date)} 新闻日刊 · 海波东`} description="中文优先阅读 AI 与经济资讯，英文来源提供中英对照。" wide>
<div class="news-workspace" data-issue-date={issue.date} data-checked-at={issue.checkedAt} data-archive={String(archive)}>
  <aside class="daily-sidebar">
    <a class="daily-wordmark" href={path('news/')}>海波东的日刊<span>从消息，走向理解。</span></a>
    <p class="sidebar-intro">中文资讯 · 英文对照<br/>AI 前沿与经济观察<br/>每条内容，都有来处。</p>
    <a class="sidebar-back" href={path()}>回到个人博客 ↗</a>
    <details class="date-picker" open><summary>按日期翻阅 <span aria-hidden="true">⌄</span></summary><nav class="news-dates" aria-label="新闻日期">{issues.slice(0,14).map(i=><a href={path(`news/${i.date}/`)} aria-current={i.date===issue.date?'page':undefined} class:list={{chosen:i.date===issue.date}}><time datetime={i.date}>{Number(i.date.slice(5,7))}月{Number(i.date.slice(8))}日</time><span>{i.stories.length}</span></a>)}<a href={path('news/archive/')}>更多日期 ↗</a></nav></details>
    <div class="sidebar-bottom"><p>{reviewed} 更新（北京时间）<br/>原文可查 · 免费机译</p><div class="sidebar-actions"><a href={path('news/rss.xml')}>订阅 RSS ↗</a><a href={path('news/sources/')}>信息源 ↗</a></div><a class="editorial-link" href="https://github.com/ma1203580780/mind/blob/main/docs/NEWS_EDITORIAL.md" target="_blank" rel="noopener noreferrer">编辑规则 ↗</a></div>
  </aside>
  <section class="daily-board" aria-labelledby="news-title">
    <div class="daily-board-top"><div><p class="edition-eyebrow">{archive?'往期日刊':'今日阅读'} <time class="date-badge" datetime={issue.date}>{newsDate(issue.date)}</time></p><h1 id="news-title">看懂 AI，也看懂经济。</h1><p>{issue.stories.length} 条内容 · {sourceCount} 个来源 · <a href={path('news/sources/')}>采集状态 ↗</a></p></div><div class="news-toolbar" data-news-controls hidden><label class="news-search"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input id="news-query" type="search" placeholder="搜中文、英文、来源" aria-label="搜索本期新闻" autocomplete="off"/></label><div class="news-view" role="group" aria-label="新闻展示方式"><button type="button" data-view="cards" aria-pressed="true">图文</button><button type="button" data-view="list" aria-pressed="false">紧凑</button></div></div></div>
    <div class="news-filter-panel" data-news-controls hidden>
      <div class="news-language-tabs" role="group" aria-label="按来源语言筛选"><button data-language="all" aria-pressed="true">全部 <small>{issue.stories.length}</small></button><button data-language="zh" aria-pressed="false">中文资讯 <small>{zhCount}</small></button><button data-language="en" aria-pressed="false">英文对照 <small>{enCount}</small></button></div>
      <div class="news-categories" role="group" aria-label="筛选新闻分类"><button type="button" class="chosen" data-category="全部" aria-pressed="true">全部主题</button>{categories.map(c=><button type="button" data-category={c} aria-pressed="false">{c}</button>)}</div>
    </div>
    <div class="reading-hint"><span>中文优先</span>点击标题或正文展开阅读；英文资讯可核对原文。</div>
    <p class="news-stale" id="news-stale" hidden>本期距今超过 36 小时，新的内容尚未发布。</p>
    <p class="news-result" id="news-result" aria-live="polite" hidden></p>
    <div class="news-grid" id="news-grid" data-view="cards">{stories.map((story,index)=><NewsCard story={story} issue={issue.date} index={index}/>)}</div>
    <div class="news-empty" id="news-empty" hidden><h2>没有匹配内容</h2><p>试试其他来源语言、主题或关键词。</p><button type="button" id="news-reset">重置全部筛选</button></div>
    <div class="news-edition-note"><p>机构公告、媒体报道、论文预印本与开源版本均有类型标注。每期最多 200 条，按真实更新数量收录。</p><a href={path('news/sources/')}>查看中英信息源与更新状态 ↗</a></div>
  </section>
</div>
</Base>
<script>
import {track} from '../scripts/analytics';
const page=document.querySelector<HTMLElement>('.news-workspace');const grid=document.querySelector<HTMLElement>('#news-grid');
if(page&&grid){
 document.querySelectorAll<HTMLElement>('[data-news-controls]').forEach(el=>el.hidden=false);
 const picker=document.querySelector<HTMLDetailsElement>('.date-picker');if(picker&&matchMedia('(max-width:850px)').matches)picker.open=false;
 const cards=[...grid.querySelectorAll<HTMLElement>('.news-card')],input=document.querySelector<HTMLInputElement>('#news-query')!,result=document.querySelector<HTMLElement>('#news-result')!;
 const categories=[...document.querySelectorAll<HTMLButtonElement>('button[data-category]')],languages=[...document.querySelectorAll<HTMLButtonElement>('button[data-language]')];
 let category='全部',language='all';
 const filter=()=>{const words=input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);let count=0;for(const card of cards){const match=(category==='全部'||card.dataset.category===category)&&(language==='all'||card.dataset.language===language)&&words.every(w=>card.dataset.search!.includes(w));card.hidden=!match;if(match)count++;}result.hidden=false;result.textContent=`${language==='zh'?'中文资讯':language==='en'?'英文对照':'全部来源'} · ${category==='全部'?'全部主题':category} · ${count} 条`;document.querySelector<HTMLElement>('#news-empty')!.hidden=count>0;grid.classList.remove('feed-refreshed');requestAnimationFrame(()=>grid.classList.add('feed-refreshed'));};
 categories.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.category!;categories.forEach(b=>{b.classList.toggle('chosen',b===button);b.setAttribute('aria-pressed',String(b===button))});track('news_filter',{category});filter();}));
 languages.forEach(button=>button.addEventListener('click',()=>{language=button.dataset.language!;languages.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));filter();}));
 input.addEventListener('input',filter);let timer:ReturnType<typeof setTimeout>;input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{if(input.value.trim())track('search_used',{area:'news',results:cards.filter(c=>!c.hidden).length})},1200)});
 document.querySelector('#news-reset')?.addEventListener('click',()=>{input.value='';categories[0].click();languages[0].click();input.focus();});
 const views=[...document.querySelectorAll<HTMLButtonElement>('button[data-view]')];const setView=(view:string)=>{grid.dataset.view=view==='list'?'list':'cards';views.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===grid.dataset.view)))};
 try{setView(localStorage.getItem('news-view')||'cards')}catch{}views.forEach(b=>b.addEventListener('click',()=>{setView(b.dataset.view!);track('news_view',{view:grid.dataset.view!});try{localStorage.setItem('news-view',grid.dataset.view!)}catch{}}));
 document.querySelectorAll<HTMLImageElement>('.news-figure img,.reader-image img').forEach(img=>{const hide=()=>{const figure=img.closest<HTMLElement>('figure');if(figure)figure.hidden=true;};img.addEventListener('error',hide);if(img.complete&&!img.naturalWidth)hide();});
 let opener:HTMLButtonElement|null=null;
 document.querySelectorAll<HTMLButtonElement>('[data-reader]').forEach(button=>button.addEventListener('click',()=>{const dialog=document.getElementById(button.dataset.reader!) as HTMLDialogElement|null;if(!dialog)return;opener=button;dialog.showModal();document.documentElement.classList.add('reader-is-open');track('news_expand',{story:dialog.id.replace('reader-','')});}));
 document.querySelectorAll<HTMLDialogElement>('.news-reader').forEach(dialog=>{const close=()=>dialog.close();dialog.querySelector('[data-close-reader]')?.addEventListener('click',close);dialog.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)close();}});dialog.addEventListener('close',()=>{document.documentElement.classList.remove('reader-is-open');opener?.focus({preventScroll:true});});});
 if(page.dataset.archive!=='true'&&Date.now()-Date.parse(page.dataset.checkedAt!)>36*60*60*1000)document.querySelector<HTMLElement>('#news-stale')!.hidden=false;
}
</script>
