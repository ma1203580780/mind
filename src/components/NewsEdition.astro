---
import Base from '../layouts/Base.astro';
import NewsCard from './NewsCard.astro';
import NewsPagination from './NewsPagination.astro';
import {path} from '../site';
import {issues,allNews,newsDate,sourceHost,filterNews,paginateNews,type NewsIssue} from '../lib/news';
import {entriesForScope,newsListPath,NEWS_PAGE_SIZE} from '../lib/news-navigation';
import collectionStatus from '../data/news-status.json';
import '../styles/news.css';
import '../styles/news-reader.css';
import '../styles/news-browser.css';
import '../styles/news-flow.css';
const {issue,archive=false,scope:requestedScope,language='all',category='全部',page:requestedPage=1}=Astro.props as {issue:NewsIssue;archive?:boolean;scope?:string;language?:string;category?:string;page?:number};
const scope=requestedScope||(archive?issue.date:'history'),cumulative=scope==='history';
const entries=entriesForScope(scope),selected=filterNews(entries,{language,category});
const {entries:stories,page,pageCount,total}=paginateNews(selected,requestedPage,NEWS_PAGE_SIZE);
const categories=['全部',...new Set(entries.map(s=>s.category))];
const langCounts=['all','zh','en'].map(lang=>filterNews(entries,{language:lang,category}).length);
const categoryCounts=categories.map(c=>filterNews(entries,{language,category:c}).length);
const sourceCount=new Set(selected.map(s=>sourceHost(s.sourceUrl))).size;
const checkedAt=cumulative?collectionStatus.checkedAt:issue.checkedAt;
const reviewed=new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(checkedAt));
const first=total?(page-1)*NEWS_PAGE_SIZE+1:0,last=Math.min(page*NEWS_PAGE_SIZE,total);
const title=`${cumulative?'新闻与观察':newsDate(issue.date)+' 新闻日刊'}${language==='zh'?' · 中文':language==='en'?' · 英文对照':''}${category!=='全部'?' · '+category:''}${page>1?' · 第 '+page+' 页':''} · 海波东`;
---
<Base title={title} description="累计阅读 AI 与经济资讯，按发布时间倒序排列，每页 100 条。英文来源提供中文机译和中英对照。" noindex={language!=='all'||category!=='全部'} wide>
<div class="news-workspace" data-issue-date={scope} data-checked-at={checkedAt} data-archive={String(!cumulative)}>
  <aside class="daily-sidebar">
    <a class="daily-wordmark" href={path('news/')}>海波东的日刊<span>从消息，走向理解。</span></a>
    <p class="sidebar-intro">中文资讯 · 英文对照<br/>AI 前沿与经济观察<br/>每天留下新的观察。</p>
    <a class="sidebar-back" href={path()}>回到个人博客 ↗</a>
    <details class="date-picker" open><summary>按日期翻阅 <span aria-hidden="true">⌄</span></summary><nav class="news-dates" aria-label="新闻日期">
      <a href={path('news/')} aria-current={cumulative?'page':undefined} class:list={{chosen:cumulative}}><span>全部历史</span><span>{allNews.length}</span></a>
      {issues.slice(0,14).map(i=><a href={path(`news/${i.date}/`)} aria-current={!cumulative&&i.date===issue.date?'page':undefined} class:list={{chosen:!cumulative&&i.date===issue.date}}><time datetime={i.date}>{Number(i.date.slice(5,7))}月{Number(i.date.slice(8))}日</time><span>{i.stories.length}</span></a>)}
      <a href={path('news/archive/')}>更多日期 ↗</a>
    </nav></details>
    <div class="sidebar-bottom"><p>最近采集 {reviewed}<br/>北京时间 · 原文可查</p><div class="sidebar-actions"><a href={path('news/rss.xml')}>订阅 RSS ↗</a><a href={path('news/sources/')}>信息源 ↗</a></div><a class="editorial-link" href="https://github.com/ma1203580780/mind/blob/main/docs/NEWS_EDITORIAL.md" target="_blank" rel="noopener noreferrer">编辑规则 ↗</a></div>
  </aside>
  <section class="daily-board" aria-labelledby="news-title">
    <div class="daily-board-top"><div><p class="edition-eyebrow">{cumulative?'持续记录':'按日回看'} <time class="date-badge" datetime={issue.date}>{cumulative?'累计 '+issues.length+' 天':newsDate(issue.date)}</time></p><h1 id="news-title">看懂 AI，也看懂经济。</h1><p>{allNews.length} 条历史资讯 · {sourceCount} 个当前来源 · <a href={path('news/sources/')}>采集状态 ↗</a></p></div>
      <div class="news-toolbar" data-news-controls hidden><label class="news-search"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input id="news-query" type="search" placeholder="搜本页内容、来源" aria-label="搜索本页新闻" autocomplete="off"/></label><div class="news-view" role="group" aria-label="新闻展示方式"><button type="button" data-view="cards" aria-pressed="true">图文</button><button type="button" data-view="list" aria-pressed="false">紧凑</button></div></div>
    </div>
    <div class="news-filter-panel">
      <nav class="news-language-tabs" aria-label="按来源语言筛选">{['all','zh','en'].map((lang,i)=><a href={newsListPath(scope,lang,category,1)} aria-current={language===lang?'page':undefined} aria-label={`${i===0?'全部资讯':i===1?'中文资讯':'英文对照'}，${langCounts[i]}条`}>{i===0?'全部':i===1?'中文':'英文对照'}<small>{langCounts[i]}</small></a>)}</nav>
      <details class="topic-picker"><summary><span>主题</span><strong>{category==='全部'?'全部主题':category}</strong><svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg></summary><nav aria-label="筛选新闻主题">{categories.map((c,i)=><a href={newsListPath(scope,language,c,1)} data-category={c} aria-current={category===c?'page':undefined}><span>{c==='全部'?'全部主题':c}</span><small>{categoryCounts[i]}</small></a>)}</nav></details>
    </div>
    <div class="news-list-context"><p>{cumulative?'全部历史':newsDate(issue.date)} <span>· 发布时间倒序</span><strong>{first}–{last} / {total} 条</strong></p><NewsPagination scope={scope} language={language} category={category} page={page} pageCount={pageCount} total={total} compact/></div>
    <p class="news-stale" id="news-stale" hidden>最近一次成功采集距今超过 36 小时，可在信息源页查看状态。</p>
    <p class="news-result" id="news-result" aria-live="polite" hidden></p>
    <div class="news-grid" id="news-grid" data-view="cards">{stories.map((story,index)=><NewsCard story={story} issue={story.issueDate} index={index}/>)}</div>
    {total===0&&<div class="news-empty"><h2>这个板块暂无内容</h2><p>有新的真实资讯收录后，会自动出现在这里。</p><a href={newsListPath(scope)}>查看全部资讯 ↗</a></div>}
    <div class="news-empty" id="news-empty" hidden><h2>本页没有匹配内容</h2><p>试试其他关键词，或清空搜索后翻到下一页。</p><button type="button" id="news-reset">清空搜索</button></div>
    <NewsPagination scope={scope} language={language} category={category} page={page} pageCount={pageCount} total={total}/>
    <div class="news-edition-note"><p>历史持续累计，每页 100 条。按原文发布时间排序，日期与来源可核对；只有日期的内容按当日记录排序。</p><p>每天北京时间 08:17、14:17、20:17 计划采集。同一日多次运行追加新内容，每天最多 200 条。</p><a href={path('news/sources/')}>查看中英信息源与更新状态 ↗</a></div>
  </section>
</div>
</Base>
<script>
import {track} from '../scripts/analytics';
import {initNewsFlow} from '../scripts/news-flow';
const workspace=document.querySelector<HTMLElement>('.news-workspace'),grid=document.querySelector<HTMLElement>('#news-grid');
if(workspace&&grid){
 document.querySelectorAll<HTMLElement>('[data-news-controls]').forEach(el=>el.hidden=false);
 const picker=document.querySelector<HTMLDetailsElement>('.date-picker');if(picker&&matchMedia('(max-width:850px)').matches)picker.open=false;
 const flow=initNewsFlow(grid);
 const cards=[...grid.querySelectorAll<HTMLElement>('.news-card')],input=document.querySelector<HTMLInputElement>('#news-query')!,result=document.querySelector<HTMLElement>('#news-result')!;
 const filter=()=>{const words=input.value.normalize('NFKC').toLowerCase().trim().split(/\s+/).filter(Boolean);let count=0;for(const card of cards){card.hidden=!words.every(w=>card.dataset.search!.normalize('NFKC').includes(w));if(!card.hidden)count++;}result.hidden=!words.length;result.textContent=`本页匹配 ${count} / ${cards.length} 条`;document.querySelector<HTMLElement>('#news-empty')!.hidden=count>0||cards.length===0;flow.refresh();};
 input.addEventListener('input',filter);let timer:ReturnType<typeof setTimeout>;input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{if(input.value.trim())track('search_used',{area:'news',results:cards.filter(c=>!c.hidden).length})},1200)});
 document.querySelector('#news-reset')?.addEventListener('click',()=>{input.value='';filter();input.focus();});
 const views=[...document.querySelectorAll<HTMLButtonElement>('button[data-view]')];const setView=(view:string)=>{grid.dataset.view=view==='list'?'list':'cards';views.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===grid.dataset.view)));flow.refresh();};
 try{setView(localStorage.getItem('news-view')||'cards')}catch{}views.forEach(b=>b.addEventListener('click',()=>{setView(b.dataset.view!);track('news_view',{view:grid.dataset.view!});try{localStorage.setItem('news-view',grid.dataset.view!)}catch{}}));
 const topic=document.querySelector<HTMLDetailsElement>('.topic-picker');document.addEventListener('click',event=>{if(topic?.open&&!topic.contains(event.target as Node))topic.open=false;});topic?.addEventListener('keydown',event=>{if(event.key==='Escape'){topic.open=false;topic.querySelector<HTMLElement>('summary')?.focus();}});
 topic?.querySelectorAll<HTMLAnchorElement>('a').forEach(a=>a.addEventListener('click',()=>track('news_filter',{category:a.dataset.category||'全部'})));
 document.querySelectorAll<HTMLImageElement>('.news-figure img,.reader-image img').forEach(img=>{const hide=()=>{const figure=img.closest<HTMLElement>('figure');if(figure)figure.hidden=true;flow.refresh();};img.addEventListener('error',hide);if(img.complete&&!img.naturalWidth)hide();});
 let opener:HTMLButtonElement|null=null;
 document.querySelectorAll<HTMLButtonElement>('[data-reader]').forEach(button=>button.addEventListener('click',()=>{const dialog=document.getElementById(button.dataset.reader!) as HTMLDialogElement|null;if(!dialog)return;opener=button;dialog.showModal();document.documentElement.classList.add('reader-is-open');track('news_expand',{story:dialog.id.replace('reader-','')});}));
 document.querySelectorAll<HTMLDialogElement>('.news-reader').forEach(dialog=>{const close=()=>dialog.close();dialog.querySelector('[data-close-reader]')?.addEventListener('click',close);dialog.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)close();}});dialog.addEventListener('close',()=>{document.documentElement.classList.remove('reader-is-open');opener?.focus({preventScroll:true});});});
 if(workspace.dataset.archive!=='true'&&Date.now()-Date.parse(workspace.dataset.checkedAt!)>36*60*60*1000)document.querySelector<HTMLElement>('#news-stale')!.hidden=false;
}
</script>
