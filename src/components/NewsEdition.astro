---
import Base from '../layouts/Base.astro';
import NewsCard from './NewsCard.astro';
import NewsPagination from './NewsPagination.astro';
import {path} from '../site';
import {issues,allNews,newsDate,sourceHost,filterNews,paginateNews,type NewsIssue} from '../lib/news';
import {entriesForScope,newsListPath,NEWS_PAGE_SIZE} from '../lib/news-navigation';
import {NEWS_TOPICS,newsTopic,TOPIC_DESCRIPTIONS} from '../lib/news-topics.mjs';
import configured from '../config/news-sources.json';
import collectionStatus from '../data/news-status.json';
import '../styles/news.css';
import '../styles/news-reader.css';
import '../styles/news-browser.css';
import '../styles/news-flow.css';
const {issue,archive=false,scope:requestedScope,language='all',category:requestedCategory='全部',page:requestedPage=1}=Astro.props as {issue:NewsIssue;archive?:boolean;scope?:string;language?:string;category?:string;page?:number};
const category=newsTopic(requestedCategory);
const scope=requestedScope||(archive?issue.date:'history'),cumulative=scope==='history';
const entries=entriesForScope(scope),selected=filterNews(entries,{language,category});
const {entries:stories,page,pageCount,total}=paginateNews(selected,requestedPage,NEWS_PAGE_SIZE);
const categories=NEWS_TOPICS;
const subscriptions=configured.filter(s=>category==='全部'||newsTopic(s.category)===category).filter(s=>language==='all'||s.language===language);
const description=TOPIC_DESCRIPTIONS[category]||TOPIC_DESCRIPTIONS['全部'];
const dateCount=(date:string)=>filterNews(entriesForScope(date),{language,category}).length;
const langCounts=['all','zh','en'].map(lang=>filterNews(entries,{language:lang,category}).length);
const categoryCounts=categories.map(c=>filterNews(entries,{language,category:c}).length);
const sourceCount=new Set(selected.map(s=>sourceHost(s.sourceUrl))).size;
const checkedAt=cumulative?collectionStatus.checkedAt:issue.checkedAt;
const reviewed=new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(checkedAt));
const first=total?(page-1)*NEWS_PAGE_SIZE+1:0,last=Math.min(page*NEWS_PAGE_SIZE,total);
const title=`${cumulative?'新闻与观察':newsDate(issue.date)+' 新闻日刊'}${language==='zh'?' · 中文':language==='en'?' · 英文对照':''}${category!=='全部'?' · '+category:''}${page>1?' · 第 '+page+' 页':''} · 海波东`;
---
<Base title={title} description="累计阅读 AI、设计、独立创业、营销与经济资讯，按发布时间倒序排列，每页 30 条。英文来源提供中文机译和中英对照。" noindex={language!=='all'||category!=='全部'} wide newsScope={scope} newsLanguage={language} newsCategory={category}>
<div class="news-workspace" data-issue-date={scope} data-checked-at={checkedAt} data-archive={String(!cumulative)}>
  <aside class="daily-sidebar">
    <section class="view-picker" aria-labelledby="view-title">
      <h2 id="view-title">展示方式</h2>
      <div class="news-view" role="group" aria-label="新闻展示方式" data-news-controls hidden>
        <button type="button" data-view="cards" aria-pressed="true"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2" width="4" height="5" rx="1"/><rect x="10" y="2" width="4" height="5" rx="1"/><rect x="2" y="10" width="4" height="4" rx="1"/><rect x="10" y="10" width="4" height="4" rx="1"/></svg>图文</button>
        <button type="button" data-view="list" aria-pressed="false"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12M2 8h12M2 13h12"/></svg>紧凑</button>
      </div>
    </section>
    <div class="sidebar-filter">
      <label for="news-language">来源语言</label>
      <div class="sidebar-select"><select id="news-language" data-news-filter disabled>{['all','zh','en'].map((lang,i)=><option value={newsListPath(scope,lang,category,1)} selected={language===lang}>{i===0?'全部语言':i===1?'中文':'英文对照'} · {langCounts[i]}</option>)}</select><span aria-hidden="true">⌄</span></div>
    </div>
    <div class="sidebar-filter">
      <label for="news-date">收录日期</label>
      <div class="sidebar-select"><select id="news-date" data-news-filter disabled>
        <option value={newsListPath('history',language,category)} selected={cumulative}>全部日期 · {dateCount('history')}</option>
        {issues.map(i=><option value={newsListPath(i.date,language,category)} selected={scope===i.date}>{i.date.replaceAll('-','/')} · {dateCount(i.date)}</option>)}
      </select><span aria-hidden="true">⌄</span></div>
    </div>
    <p class="sidebar-count">{first}–{last} / {total} 条 · 时间倒序</p>
    <noscript><nav class="sidebar-fallback" aria-label="来源语言">{['all','zh','en'].map((lang,i)=><a href={newsListPath(scope,lang,category,1)}>{['全部语言','中文','英文对照'][i]}</a>)}<a href={path('news/archive/')}>按日期浏览 ↗</a></nav></noscript>
    <div class="sidebar-bottom"><p>更新于 {reviewed}</p><div class="sidebar-actions"><a href={path('news/rss.xml')}>RSS ↗</a><a href={path('news/sources/')}>信息源 ↗</a><a class="editorial-link" href="https://github.com/ma1203580780/mind/blob/main/docs/NEWS_EDITORIAL.md" target="_blank" rel="noopener noreferrer">收录规则 ↗</a></div></div>
  </aside>
  <section class="daily-board" aria-labelledby="news-title">
    <h1 id="news-title" class="sr-only">资讯</h1>    {category!=='全部'&&<p class="news-topic-description">{description}</p>}
    <p class="news-stale" id="news-stale" hidden>最近一次成功采集距今超过 36 小时，可在信息源页查看状态。</p>
    <p class="news-result" id="news-result" aria-live="polite" hidden></p>
    <div class="news-grid" id="news-grid" data-view="cards">{stories.map((story,index)=><NewsCard story={story} issue={story.issueDate} index={index}/>)}</div>
    {total===0&&<div class="news-empty"><h2>这个板块暂无内容</h2><p>{subscriptions.length?`已接入 ${subscriptions.map(s=>s.name).join("、")}。当前日期与语言组合暂无收录，下一次采集会继续检查。`:'这个语言分区暂时没有对应订阅源，可以切换全部语言查看。'}</p><a href={newsListPath('history','all',category)}>查看该分类全部历史 ↗</a></div>}

    <NewsPagination scope={scope} language={language} category={category} page={page} pageCount={pageCount} total={total}/>
    <div class="news-edition-note"><p>历史持续累计，每页 30 条。按原文发布时间排序，日期与来源可核对；只有日期的内容按当日记录排序。</p><p>每天北京时间 08:17、14:17、20:17 计划采集。同一日多次运行追加新内容，每天最多 200 条。</p><a href={path('news/sources/')}>查看中英信息源与更新状态 ↗</a></div>
  </section>
</div>
</Base>
<script>
import {track} from '../scripts/analytics';
import {navigate} from 'astro:transitions/client';

import {initNewsFlow} from '../scripts/news-flow';
import {onPageLoad} from '../scripts/page-lifecycle';
onPageLoad((signal,onCleanup)=>{
if(!document.querySelector('.news-workspace'))return;




const workspace=document.querySelector<HTMLElement>('.news-workspace'),grid=document.querySelector<HTMLElement>('#news-grid');
if(workspace&&grid){
 document.querySelectorAll<HTMLElement>('[data-news-controls]').forEach(el=>el.hidden=false);
 document.querySelectorAll<HTMLSelectElement>('[data-news-filter]').forEach(select=>{
   select.disabled=false;
   select.addEventListener('change',()=>{void navigate(select.value);},{signal});
 });

 const flow=initNewsFlow(grid);onCleanup(()=>flow.destroy());
 const views=[...document.querySelectorAll<HTMLButtonElement>('button[data-view]')];const setView=(view:string)=>{grid.dataset.view=view==='list'?'list':'cards';views.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===grid.dataset.view)));flow.refresh();};
 try{setView(localStorage.getItem('news-view')||'cards')}catch{}views.forEach(b=>b.addEventListener('click',()=>{setView(b.dataset.view!);track('news_view',{view:grid.dataset.view!});try{localStorage.setItem('news-view',grid.dataset.view!)}catch{}}));
 document.querySelectorAll<HTMLAnchorElement>('.news-topic-tabs a').forEach(a=>a.addEventListener('click',()=>track('news_filter',{category:a.dataset.category||'全部'})));
 const activeTopic=document.querySelector<HTMLElement>('.news-topic-tabs [aria-current="page"]');const topicRail=activeTopic?.parentElement;if(activeTopic&&topicRail)topicRail.scrollLeft=Math.max(0,activeTopic.offsetLeft-topicRail.offsetLeft-topicRail.clientWidth/2+activeTopic.clientWidth/2);
 document.querySelectorAll<HTMLImageElement>('.news-figure img,.reader-image img').forEach(img=>{const hide=()=>{const figure=img.closest<HTMLElement>('figure');if(figure)figure.hidden=true;flow.refresh();};img.addEventListener('error',hide);if(img.complete&&!img.naturalWidth)hide();});
 let opener:HTMLButtonElement|null=null;
 document.querySelectorAll<HTMLButtonElement>('[data-reader]').forEach(button=>button.addEventListener('click',()=>{const dialog=document.getElementById(button.dataset.reader!) as HTMLDialogElement|null;if(!dialog)return;opener=button;dialog.showModal();document.documentElement.classList.add('reader-is-open');track('news_expand',{story:dialog.id.replace('reader-','')});}));
 document.querySelectorAll<HTMLDialogElement>('.news-reader').forEach(dialog=>{const close=()=>dialog.close();dialog.querySelector('[data-close-reader]')?.addEventListener('click',close);dialog.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)close();}});dialog.addEventListener('close',()=>{document.documentElement.classList.remove('reader-is-open');opener?.focus({preventScroll:true});});});
 const openHash=()=>{const id=location.hash.slice(1);if(!id.startsWith('reader-'))return;const dialog=document.getElementById(id);if(dialog instanceof HTMLDialogElement&&!dialog.open){opener=[...document.querySelectorAll<HTMLButtonElement>('[data-reader]')].find(b=>b.dataset.reader===id)||null;opener?.click();}};openHash();window.addEventListener('hashchange',openHash,{signal});
 if(workspace.dataset.archive!=='true'&&Date.now()-Date.parse(workspace.dataset.checkedAt!)>36*60*60*1000)document.querySelector<HTMLElement>('#news-stale')!.hidden=false;
}

});
</script>
