---
import Base from '../layouts/Base.astro';import '../styles/explore.css';import {path} from '../site';import {NEWS_TOPICS} from '../lib/news-topics.mjs';
const waves=Array.from({length:32},(_,i)=>{const points=Array.from({length:81},(_,j)=>{const x=j*15;const y=310+i*8+Math.sin(x/235+i*.035)*72+Math.cos(x/390+i*.05)*48;return `${j?'L':'M'}${x},${y.toFixed(2)}`});return points.join(' ')});
---
<Base title="搜索 · 海波东" noindex><div class="search-canvas"><svg class="search-waves" viewBox="0 0 1200 680" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><linearGradient id="wave-fade" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="white" stop-opacity="0"/><stop offset="35%" stop-color="white"/><stop offset="80%" stop-color="white"/><stop offset="100%" stop-color="white" stop-opacity="0"/></linearGradient><mask id="wave-mask"><rect width="1200" height="680" fill="url(#wave-fade)"/></mask></defs><g fill="none" stroke="currentColor" stroke-width=".7" mask="url(#wave-mask)">{waves.map(d=><path d={d}/>)}</g></svg><div id="site-search" data-index={path('search-index.json')}>
<h1 class="sr-only">全站搜索</h1><form class="search-form" role="search"><label class="sr-only" for="query">搜索站内内容</label><input id="query" name="q" type="search" placeholder="搜索本站内容…" autocomplete="off"/><button type="submit" class="search-submit" aria-label="搜索" title="搜索"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.5"/><path d="m15.15 15.15 4.6 4.6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></button></form>

<div class="search-panel">
<div class="search-filters" id="news-filters" hidden><label>来源语言 <select id="content-language"><option value="all">全部语言</option><option value="zh">中文来源</option><option value="en">英文来源</option></select></label><label>分类 <select id="content-category">{NEWS_TOPICS.map(t=><option value={t}>{t}</option>)}</select></label></div>
<div class="search-summary"><p id="search-status" role="status">正在加载索引…</p><button id="clear-filters" type="button" hidden>清除筛选</button></div>

<button id="retry-index" class="quiet-button" hidden>重新加载</button><section id="results" class="search-list" aria-label="搜索结果"></section><nav id="result-pages" class="result-footer" aria-label="搜索结果分页" hidden><button id="previous-page">上一页</button><span id="page-label"></span><button id="next-page">下一页</button></nav>
</div></div></div><noscript><p>搜索需要 JavaScript。也可以浏览<a href={path('archive/')}>博客</a>和<a href={path('news/')}>资讯</a>。</p></noscript></Base>
<script>import '../scripts/search';</script>
