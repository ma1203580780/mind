---
import Base from '../layouts/Base.astro';import {path} from '../site';import {NEWS_TOPICS} from '../lib/news-topics.mjs';
---
<Base title="全站搜索 · 海波东" noindex><section class="page-heading"><h1 class="sr-only">全站搜索</h1><label class="searchbox"><span class="sr-only">搜索文章与全部历史新闻</span><input id="query" type="search" placeholder="搜索标题、正文、原文或来源…" autocomplete="off"/></label></section><div id="reading-browser" data-index={path('search-index.json')} data-mode="search"><div class="reading-controls"><label><span class="sr-only">内容类型</span><select id="content-kind"><option value="all">全部内容</option><option value="post">本站文章</option><option value="news">历史资讯</option></select></label><label><span class="sr-only">来源语言</span><select id="content-language"><option value="all">全部语言</option><option value="zh">中文来源</option><option value="en">英文对照</option></select></label><label><span class="sr-only">主题</span><select id="content-category">{NEWS_TOPICS.map(t=><option value={t}>{t}</option>)}</select></label><button id="clear-scope" type="button" hidden>取消日期限定</button></div><p id="search-status" class="collection-note" role="status">正在加载索引…</p><button id="retry-index" class="quiet-button" hidden>重新加载</button><section id="results" class="note-feed search-results" aria-label="搜索结果"></section><nav id="result-pages" class="result-footer" aria-label="搜索结果分页" hidden><button id="previous-page">上一页</button><span id="page-label"></span><button id="next-page">下一页</button></nav></div><noscript><p>全文搜索需要 JavaScript。你仍可浏览<a href={path('archive/')}>文章归档</a>与<a href={path('news/')}>新闻日期归档</a>。</p></noscript></Base>
<script>import '../scripts/reading-browser';</script>
