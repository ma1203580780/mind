---
import Base from '../layouts/Base.astro';import {path} from '../site';
---
<Base title="搜索 · 海波东" noindex><section class="page-heading"><span class="eyebrow">全文搜索</span><h1>找到那段值得重读的内容。</h1><label class="searchbox"><span class="sr-only" style="position:absolute;clip:rect(0,0,0,0)">搜索文章</span><input id="query" type="search" placeholder="搜索标题、主题或正文…" autocomplete="off"/></label><p id="search-status" class="search-status" role="status">输入关键词开始搜索。</p></section><section id="results" class="search-results note-feed" aria-label="搜索结果" data-index={path('search-index.json')}></section></Base>
<script>
import {track} from '../scripts/analytics';
const q=document.querySelector<HTMLInputElement>('#query')!;const results=document.querySelector<HTMLElement>('#results')!;const status=document.querySelector<HTMLElement>('#search-status')!;let posts:any[]=[];let loaded=false,failed=false;
function show(){results.replaceChildren();const terms=q.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);if(!terms.length){status.textContent='输入关键词开始搜索。';return}if(failed){status.textContent='搜索索引加载失败，请刷新页面重试。';return}if(!loaded){status.textContent='正在加载文章索引…';return}const matches=posts.filter(p=>terms.every(t=>[p.title,p.description,p.category,p.tags.join(' '),p.body].join(' ').toLocaleLowerCase().includes(t)));status.textContent=matches.length?`找到 ${matches.length} 篇文章`:'没有找到相关内容，试试更短的关键词。';matches.forEach(p=>{const a=document.createElement('a');a.className='search-result';a.href=p.url;const meta=document.createElement('span');meta.className='category';meta.textContent=p.category+(p.demo?' · 示例稿':'');const h=document.createElement('h2');h.textContent=p.title;const d=document.createElement('p');d.textContent=p.description;a.append(meta,h,d);results.append(a)})}
let searchTimer:ReturnType<typeof setTimeout>;q.addEventListener('input',()=>{show();clearTimeout(searchTimer);searchTimer=setTimeout(()=>{if(loaded&&q.value.trim())track('search_used',{area:'articles',results:results.children.length})},1200)});q.value=new URLSearchParams(location.search).get('q')||'';fetch(results.dataset.index!).then(r=>{if(!r.ok)throw Error();return r.json()}).then(data=>{posts=data;loaded=true;show()}).catch(()=>{failed=true;show()});show();
</script>
