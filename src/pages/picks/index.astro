---
import Base from '../../layouts/Base.astro';import SourceCard from '../../components/SourceCard.astro';import {allNews,issues} from '../../lib/news';import {path} from '../../site';import {readingCandidates,candidateReason,latestNewsDate,editorPicks} from '../../lib/discovery';
const candidates=readingCandidates(allNews,latestNewsDate,5);
---
<Base title="值得一读 · 海波东" description="从近期资讯中按明确规则选出最多五条阅读候选，保留来源。"><header class="discovery-intro"><span class="eyebrow">少一点，也读深一点 <span>{latestNewsDate}</span></span><h1>值得一读。</h1><p>从近七天的资讯里，选出今天可以开始阅读的五条。</p><div class="discovery-links"><a href={path('news/')}>全部历史 ↗</a><a href={path('topics/')}>按专题阅读 ↗</a><a href={path('subscribe/')}>订阅更新 ↗</a></div></header>{editorPicks.length>0&&<section class="collection-section"><div class="section-title"><h2>作者精选</h2></div><div class="note-feed">{editorPicks.map(story=><div class="feed-item"><p class="candidate-reason">作者确认 · {story.editorReason}</p><SourceCard story={story} issue={story.issueDate}/></div>)}</div></section>}<details class="rule-panel"><summary>自动候选 · 如何入选？</summary><p>以最近收录日为基准，只考虑近七天、有较完整摘要、中文原文或中文标题译文可用的内容；按发布时间优先，尽量覆盖不同板块，每个来源最多一条，每次最多五条。图片数量、访问量不参与排序。</p><p>这是规则筛选，不代表作者推荐，也不构成事实核验。作者确认的观点会单独署名发布。</p></details><section class="note-feed" aria-label="自动阅读候选">{candidates.map(story=><div class="feed-item"><small class="candidate-reason">{candidateReason(story)}</small><SourceCard story={story} issue={story.issueDate}/></div>)}</section>{!candidates.length&&<p class="reading-empty">这次没有符合条件的候选，可以直接查看全部资讯。</p>}<section class="collection-section"><div class="section-title"><h2>按收录日回看</h2></div><div class="discovery-links">{issues.slice(0,7).map(issue=><a href={path(`news/${issue.date}/`)}>{issue.date} ↗</a>)}</div><p class="collection-note">原文发布时间保留在卡片上；收录日期用于归档。</p></section></Base>
