---
import Base from '../../layouts/Base.astro';import ArticleMedia from '../../components/ArticleMedia.astro';import {render} from 'astro:content';import {getPosts,path,dateLabel,reading} from '../../site';
import SaveButton from '../../components/SaveButton.astro';import {topics} from '../../lib/discovery';
export async function getStaticPaths(){return (await getPosts()).map(post=>({params:{id:post.id},props:{post}}))};
const {post}=Astro.props;const {Content,headings}=await render(post);const toc=headings.filter(h=>h.depth===2||h.depth===3);
---
<Base title={`${post.data.title} · 海波东`} description={post.data.description} noindex={post.data.demo}><div class="reading-progress" id="progress" aria-hidden="true"></div><header class="article-header"><a class="back" href={path('archive/')}>全部文章</a><div class="meta"><span class="category">{post.data.category}</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>{reading(post.body)} 分钟阅读</span>{post.data.authorship==='assisted'&&<span>本站记录 · AI 辅助</span>}{post.data.demo&&<span class="demo-label">示例稿</span>}</div><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><div class="tags">{post.data.tags.map(tag=><a href={path(`tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}</div><div class="reading-actions article-reading-actions" data-article-reading-id={`post:${post.id}`}><SaveButton id={`post:${post.id}`}/><a href={path('reading/')}>我的阅读 ↗</a></div></header><ArticleMedia post={post}/><div class="article-grid" id="panel-read" role="tabpanel" aria-labelledby="tab-read" tabindex="0"><article class="prose" id="article">{post.data.demo&&<div class="notice">这是一篇展示排版与阅读体验的示例稿。</div>}<div class="article-body"><Content/></div><div class="discovery-links">{topics.filter(t=>post.data.tags.some(tag=>t.tags.includes(tag))).map(t=><a href={path(`topics/${t.slug}/`)}>{t.name} · 持续专题 ↗</a>)}</div><div class="article-end"><span>本文结束</span><button id="copy-link" class="text-button">复制文章链接</button></div><p id="copy-status" role="status"></p></article>{toc.length>0&&<aside class="toc"><strong>本文目录</strong><nav aria-label="文章目录">{toc.map(h=><a class:list={{sub:h.depth===3}} href={`#${h.slug}`}>{h.text}</a>)}</nav><a class="backtop" href="#main">回到顶部</a></aside>}</div></Base>
<script>

import {onPageLoad} from '../../scripts/page-lifecycle';
onPageLoad((signal,onCleanup)=>{
if(!document.querySelector('#article'))return;
const update=()=>{const el=document.querySelector<HTMLElement>('#progress');const max=document.documentElement.scrollHeight-innerHeight;if(el)el.style.width=`${max>0?Math.min(100,scrollY/max*100):0}%`};addEventListener('scroll',update,{passive:true,signal});update();document.querySelector('#copy-link')?.addEventListener('click',async()=>{const s=document.querySelector('#copy-status');try{await navigator.clipboard.writeText(location.href);if(s)s.textContent='链接已复制'}catch{if(s)s.textContent='请复制浏览器地址栏中的文章链接'}});document.querySelectorAll('pre').forEach(pre=>{const b=document.createElement('button');b.className='copy-code';b.textContent='复制代码';b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(pre.querySelector('code')?.textContent||'');b.textContent='已复制'}catch{b.textContent='请手动复制'}});pre.append(b)});
});
</script>
