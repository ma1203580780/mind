---
import Base from '../../layouts/Base.astro';import ArticleMedia from '../../components/ArticleMedia.astro';import {render} from 'astro:content';import {getPosts,path,dateLabel,reading} from '../../site';
import {discussionUrl,discover} from '../../lib/connections';
import {topics} from '../../lib/discovery';
import ReadingArticle from '../../components/ReadingArticle.astro';
import readingArticles from '../../data/reading-articles.json';
export async function getStaticPaths(){return (await getPosts({includeDrafts:import.meta.env.DEV})).map(post=>({params:{id:post.id},props:{post}}))};
const {post}=Astro.props;
const readingArticle=readingArticles[post.id as keyof typeof readingArticles];
const related=(await getPosts()).filter(p=>p.id!==post.id&&!p.data.demo).map(p=>({post:p,score:p.data.tags.filter(t=>post.data.tags.includes(t)).length})).sort((a,b)=>b.score-a.score||b.post.data.date.valueOf()-a.post.data.date.valueOf()).slice(0,2).map(p=>p.post);const {Content,headings}=await render(post);const toc=headings.filter(h=>h.depth===2||h.depth===3);
---
{readingArticle ? <ReadingArticle article={readingArticle} post={post}/> : <Base title={`${post.data.title} · 海波东`} description={post.data.description} noindex={post.data.demo||post.data.draft}><div class="reading-progress" id="progress" aria-hidden="true"></div><header class="article-header"><a class="back" href={path('archive/')}>全部博客</a><div class="meta"><span class="category">{post.data.category}</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>{reading(post.body)} 分钟阅读</span>{post.data.authorship==='assisted'&&<span>本站记录 · AI 辅助</span>}{post.data.demo&&<span class="demo-label">示例稿</span>}</div><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><div class="tags">{post.data.tags.map(tag=><a href={path(`tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}</div></header><ArticleMedia post={post}/><div class="article-grid" id="panel-read" role="tabpanel" aria-labelledby="tab-read" tabindex="0"><article class="prose" id="article">{post.data.demo&&<div class="notice">这是一篇展示排版与阅读体验的示例稿。</div>}{post.data.draft&&<div class="notice" role="status">本地草稿预览 · 关闭草稿开关并推送到 GitHub 后才会上线。</div>}<div class="article-body"><Content/></div><div class="discovery-links">{topics.filter(t=>post.data.tags.some(tag=>t.tags.includes(tag))).map(t=><a href={path(`topics/${t.slug}/`)}>{t.name} · 持续专题 ↗</a>)}</div><div class="article-end"><span>本文结束</span><button id="copy-link" class="text-button">复制文章链接</button></div><p id="copy-status" role="status"></p><section class="article-connection"><h2>如果你也在研究这个问题</h2><p>欢迎带着你的经验和想法一起聊聊，或者看看我最近在做什么。</p><div class="inline-links"><a href={discussionUrl(`读后交流：${post.data.title}`,`文章：${new URL(path(`posts/${post.id}/`),Astro.site).href}`)} target="_blank" rel="noopener noreferrer" data-connection-event="article_discussion_click">参与讨论 ↗</a><a href={path('discover/')} data-connection-event="article_discover_click">去发现 →</a></div>{!discover.discussionsUrl&&<small>讨论暂通过 GitHub Issue 承接。</small>}</section>{related.length>0&&<section class="article-related"><h2>继续阅读</h2><div class="text-entries">{related.map(p=><a href={path(`posts/${p.id}/`)}><div><h3>{p.data.title}</h3><small>{p.data.category} · {reading(p.body)} 分钟</small></div><span aria-hidden="true">→</span></a>)}</div></section>}{related.length===0&&<section class="article-related"><h2>继续阅读</h2><p class="connection-note">更多文章正在积累，也可以沿着这些专题继续阅读。</p><div class="text-entries">{topics.slice(0,2).map(t=><a href={path(`topics/${t.slug}/`)}><div><h3>{t.name}</h3><small>持续专题 · {t.intro}</small></div><span aria-hidden="true">→</span></a>)}</div></section>}</article>{toc.length>0&&<aside class="toc"><strong>本文目录</strong><nav aria-label="文章目录">{toc.map(h=><a class:list={{sub:h.depth===3}} href={`#${h.slug}`}>{h.text}</a>)}</nav><a class="backtop" href="#main">回到顶部</a></aside>}</div></Base>}
<script>

import {onPageLoad} from '../../scripts/page-lifecycle';
onPageLoad((signal,onCleanup)=>{
if(!document.querySelector('#article'))return;
const update=()=>{const el=document.querySelector<HTMLElement>('#progress');const max=document.documentElement.scrollHeight-innerHeight;if(el)el.style.width=`${max>0?Math.min(100,scrollY/max*100):0}%`};addEventListener('scroll',update,{passive:true,signal});update();document.querySelector('#copy-link')?.addEventListener('click',async()=>{const s=document.querySelector('#copy-status');try{await navigator.clipboard.writeText(location.href);if(s)s.textContent='链接已复制'}catch{if(s)s.textContent='请复制浏览器地址栏中的文章链接'}});document.querySelectorAll('pre').forEach(pre=>{const b=document.createElement('button');b.className='copy-code';b.textContent='复制代码';b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(pre.querySelector('code')?.textContent||'');b.textContent='已复制'}catch{b.textContent='请手动复制'}});pre.append(b)});
});
</script>
