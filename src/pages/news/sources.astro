---
import Base from '../../layouts/Base.astro';
import status from '../../data/news-status.json';
import configured from '../../config/news-sources.json';
import {NEWS_TOPICS,newsTopic} from '../../lib/news-topics.mjs';
import {allNews} from '../../lib/news';
import '../../styles/news-reader.css';

const sources=configured.map(c=>{
  const st=status.sources.find(s=>s.id===c.id);
  return {...c,...st,category:newsTopic(c.category),ok:st?.ok||false,kind:c.kind||'订阅源'};
});
const enriched=(status as any).enrichment;
const okCount=sources.filter(s=>s.ok).length;
const failed=sources.filter(s=>!s.ok);
const ageHours=Math.floor((Date.now()-Date.parse(status.checkedAt))/3600000);
const checkedAt=new Date(status.checkedAt).toLocaleString('zh-CN',{timeZone:'Asia/Shanghai',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'});
const topics=NEWS_TOPICS.filter(t=>t!=='全部');
const byLanguage=[
  {code:'zh',title:'中文',description:'独立开发社区、创业周刊、产品与交互设计，以及 AI 与经济媒体。'},
  {code:'en',title:'英文对照',description:'模型厂商、研究预印本、央行、独立创业者、设计研究与工具团队。标题与摘要优先显示中文。'},
];
---

<Base title="中英信息源与采集状态 · 海波东">
<header class="page-heading">
  <h1>信息源与采集状态</h1>
  <p class="source-lede">{sources.length} 个公开订阅源 · 每天采集 2–4 次 · 英文自动中译对照</p>
</header>

<section class="source-stat-bar" aria-label="采集概览">
  <dl class="stat-grid">
    <div><dt>最近采集</dt><dd>{checkedAt}</dd><span>北京时间</span></div>
    <div><dt>距今</dt><dd class:list={[ageHours>=36&&'is-stale']}>{ageHours} 小时</dd><span>超过 36 小时新闻页会提示</span></div>
    <div><dt>读取成功</dt><dd>{okCount} / {sources.length}</dd><span>{failed.length?`${failed.length} 个源本次未成功`:'全部源本次正常'}</span></div>
    <div><dt>中英对照</dt><dd>{enriched?`${enriched.translated} / ${enriched.english}`:'—'}</dd><span>{enriched?`条英文内容已译 · ${enriched.images} 条有原图`:'暂无统计'}</span></div>
  </dl>
</section>

<section class="source-language-section">
  <h2>采集机制</h2>
  <ul class="rule-list">
    <li><b>计划机会 24 次/天</b><span>每 2 小时两个时间点。GitHub 的定时是尽力而为，会延迟也会漏跑，所以排得密一些。</span></li>
    <li><b>实际采集 2–4 次/天</b><span>距上次采集满 6 小时才真正抓取；其余运行只构建部署，约 45 秒。</span></li>
    <li><b>每次推送也会检查</b><span>不新鲜就顺手补一次，所以发布文章时常会顺带更新资讯。</span></li>
    <li><b>随时可手动采集</b><span>在 <a href="https://github.com/ma1203580780/mind/actions/workflows/deploy.yml" target="_blank" rel="noopener noreferrer">Actions 页面点 Run workflow</a>，或让提交信息带上 <code>[collect-news]</code>。</span></li>
  </ul>
</section>

<section class="source-language-section">
  <h2>按板块订阅 <small>{topics.length} 个板块</small></h2>
  <p>每个板块都有明确来源。快讯默认只接收近 72 小时内容；创业访谈、设计研究等低频源放宽至 7–30 天，每条只收录一次。没有新内容就等下一次，不补造资讯。</p>
  <div class="topic-source-grid">
    {topics.map(topic=>(
      <article>
        <h3>{topic}<small>{allNews.filter(s=>s.category===topic).length} 条历史</small></h3>
        <ul>
          {sources.filter(s=>s.category===topic).map(s=>(
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name} ↗</a>
              <span>{s.language==='zh'?'中文':'英文对照'} · {(s.maxAgeHours||72)>=168?`${(s.maxAgeHours||72)/24} 天`:'72 小时'}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<section class="source-language-section">
  <h2>按语言查看 <small>同一批源的另一个视角</small></h2>
  <div class="source-index">
    {byLanguage.map(group=>{
      const list=sources.filter(s=>s.language===group.code);
      return (
        <div class="index-group">
          <h3>{group.title} <small>{list.length} 个源</small></h3>
          <p>{group.description}</p>
          <ul>
            {list.map(s=>(
              <li>
                <span class:list={['dot',s.ok?'is-ok':'is-bad']} aria-hidden="true"></span>
                <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
                <span class="tag">{s.kind}</span>
                <span class="state">{s.ok?`${s.items} 条`:(s.error||'本次未成功')}</span>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
</section>

<section class="source-language-section">
  <h2>收录与翻译规则</h2>
  <dl class="rule-doc">
    <dt>时效</dt><dd>快讯只收近 72 小时未收录内容；配置 <code>maxAgeHours</code> 为 168 或 720 的低频源分别收近 7 天或 30 天，保留原发布日期。无日期、未来时间与时间窗外内容不收录。</dd>
    <dt>上限</dt><dd>整天最多 200 条，同日多次运行追加；论文预印本每天最多 30 条，版本发布最多 12 条，普通源默认最多 25 条。历史不因分页或每日更新被覆盖或截断。</dd>
    <dt>去重</dt><dd>按规范链接与标题去重，跨日依据全站历史链接去重；内容不足时优先补收录较少的板块。</dd>
    <dt>翻译</dt><dd>GitHub 云端用 Argos 英中离线模型，按模型版本与文本哈希缓存。无翻译 API 密钥，也没有按调用次数计费的服务。译文为机器翻译，数字、专有名词与研究结论请对照原文。</dd>
    <dt>配图</dt><dd>只取订阅源、发布者页面 Open Graph、正文图或 arXiv 论文图，保留出处，剔除装饰 SVG、Logo、头像与赞助图。原图失效退回文字卡，不用无关占位图。</dd>
    <dt>边界</dt><dd>不复制整篇或付费正文，不绕过登录、反爬与付费墙。自动采集不等于人工核验，不生成新闻、投资建议或无出处的解读。所有源都失败时阻止部署。</dd>
  </dl>
  <p class="section-foot">最近一次成功采集：{checkedAt}（北京时间）。失败源保留此前内容、等待下次更新，状态见上方列表。<a href="https://github.com/ma1203580780/mind/blob/main/scripts/enrich-news.py" target="_blank" rel="noopener noreferrer">查看翻译与配图实现 ↗</a></p>
</section>
</Base>

<style>
.source-lede{margin:6px 0 0;font-size:14px;color:var(--muted);line-height:1.8}
.stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin:0}
.stat-grid div{min-width:0}
.stat-grid dt{font-size:12px;color:var(--muted);margin-bottom:7px}
.stat-grid dd{margin:0;font-size:22px;font-weight:600;letter-spacing:-.02em;color:var(--ink);font-variant-numeric:tabular-nums}
.stat-grid dd.is-stale{color:#a8562a}
.stat-grid span{display:block;margin-top:6px;font-size:12px;color:var(--muted);line-height:1.7}
.rule-list{list-style:none;padding:0;margin:20px 0 0}
.rule-list li{margin:0 0 16px;font-size:14px;line-height:1.85;color:var(--muted)}
.rule-list li b{display:block;font-size:16px;font-weight:600;color:var(--ink);margin-bottom:5px}
.rule-list li span{display:block}
.rule-list code,.rule-doc code{font-size:13px;padding:1px 5px;border-radius:5px;background:var(--soft);color:var(--blue)}
.rule-doc dt{font-size:16px;font-weight:600;color:var(--ink);margin:0 0 6px}
.rule-doc dd{margin:0 0 16px;font-size:14px;line-height:1.85;color:var(--muted)}
.source-language-section>h2 small{font-size:14px;font-weight:400;color:var(--muted);margin-left:8px}
.source-index{display:grid;gap:26px;margin-top:20px}
.index-group h3{font-size:16px;font-weight:600;margin:0 0 6px;display:flex;align-items:baseline;gap:8px}
.index-group h3 small{font-size:12px;font-weight:400;color:var(--muted)}
.index-group>p{font-size:12px;color:var(--muted);line-height:1.8;margin:0 0 12px}
.index-group ul{list-style:none;padding:4px 0;margin:0;border-radius:20px;background:var(--paper);box-shadow:var(--shadow)}
.index-group li{display:grid;grid-template-columns:9px minmax(0,1fr) auto auto;align-items:baseline;gap:12px;padding:11px 20px;font-size:14px;line-height:1.7}
.index-group li+li{border-top:1px solid color-mix(in srgb,var(--line) 45%,transparent)}
.index-group a{color:var(--ink);overflow-wrap:anywhere}
.index-group a:hover{color:var(--blue)}
.index-group .dot{width:7px;height:7px;border-radius:50%;background:var(--muted);align-self:center}
.index-group .dot.is-ok{background:#8fbf72}
.index-group .dot.is-bad{background:#d08a6a}
.index-group .tag{font-size:12px;color:var(--muted);white-space:nowrap}
.index-group .state{font-size:12px;color:var(--muted);white-space:nowrap;font-variant-numeric:tabular-nums;max-width:230px;overflow:hidden;text-overflow:ellipsis}
.section-foot{margin-top:18px;font-size:12px;color:var(--muted);line-height:1.9}
.topic-source-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:22px 0 0}
.topic-source-grid article{padding:22px;border-radius:20px;background:var(--paper);box-shadow:var(--shadow)}
.topic-source-grid h3{font-size:16px;margin:0 0 14px;display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.topic-source-grid h3 small{font-size:12px;color:var(--muted);font-weight:400;white-space:nowrap}
.topic-source-grid ul{list-style:none;padding:0;margin:0}
.topic-source-grid li{margin:11px 0;font-size:14px;line-height:1.7}
.topic-source-grid li a{color:var(--ink)}
.topic-source-grid li a:hover{color:var(--blue)}
.topic-source-grid li span{display:block;font-size:12px;color:var(--muted);margin-top:2px}
@media(max-width:850px){.stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.stat-grid{gap:16px}.stat-grid dd{font-size:18px}.topic-source-grid{grid-template-columns:1fr;gap:12px}.topic-source-grid article{padding:18px}.index-group li{grid-template-columns:9px minmax(0,1fr);gap:8px;padding:11px 16px}.index-group .tag,.index-group .state{grid-column:2;max-width:100%}}
</style>
