---
import NewsEdition from '../../../../components/NewsEdition.astro';
import {issues,paginateNews} from '../../../../lib/news';
export function getStaticPaths(){return issues.flatMap(issue=>{const {pageCount}=paginateNews(issue.stories);return Array.from({length:Math.max(0,pageCount-1)},(_,i)=>({params:{date:issue.date,page:String(i+2)},props:{issue,page:i+2}}));});}
const {issue,page}=Astro.props;
---
<NewsEdition issue={issue} scope={issue.date} page={page} archive/>
