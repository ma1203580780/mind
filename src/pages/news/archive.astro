---
import Base from '../../layouts/Base.astro';
import { issues, allNews, newsDate } from '../../lib/news';
import { path } from '../../site';
import '../../styles/news.css';
---
<Base title="新闻归档 · 海波东" description="按日期回看累计保存的 AI 与经济资讯。"><div class="content-toolbar"><h1>日期归档</h1><span>{issues.length} 天 · {allNews.length} 条资讯</span></div><ol class="news-archive-list">{issues.map(issue=><li><a href={path(`news/${issue.date}/`)}><time datetime={issue.date}>{newsDate(issue.date)}</time><div><h2>{issue.title}</h2><p>{issue.intro}</p></div><small>{issue.stories.length} 条资讯 ↗</small></a></li>)}</ol></Base>
