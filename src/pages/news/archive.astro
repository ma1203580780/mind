---
import Base from '../../layouts/Base.astro';
import { issues, newsDate } from '../../lib/news';
import { path } from '../../site';
import '../../styles/news.css';
---
<Base title="新闻归档 · 海波东" description="按日期回看每天精选的 AI、工程、产品与创作动态。"><header class="page-heading"><a class="back" href={path('news/')}>← 返回最新一期</a><div class="eyebrow">新闻站点 / 日期归档</div><h1>把变化留下来。</h1><p>{issues.length} 期日刊，每一期都有日期、来源与编辑判断。</p></header><ol class="news-archive-list">{issues.map(issue=><li><a href={path(`news/${issue.date}/`)}><time datetime={issue.date}>{newsDate(issue.date)}</time><div><h2>{issue.title}</h2><p>{issue.intro}</p></div><small>{issue.stories.length} 条精选 ↗</small></a></li>)}</ol></Base>
