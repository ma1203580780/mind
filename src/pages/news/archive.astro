---
import Base from '../../layouts/Base.astro';
import { issues, allNews, newsDate } from '../../lib/news';
import { path } from '../../site';
import '../../styles/news.css';
---
<Base title="新闻归档 · 海波东" description="按日期回看累计保存的 AI 与经济资讯。"><header class="page-heading"><a class="back" href={path('news/')}>← 返回全部历史</a><div class="eyebrow">新闻站点 / 日期归档</div><h1>把变化留下来。</h1><p>{issues.length} 天记录，累计 {allNews.length} 条资讯。历史持续保留，每期按发布时间倒序，每页 100 条。</p></header><ol class="news-archive-list">{issues.map(issue=><li><a href={path(`news/${issue.date}/`)}><time datetime={issue.date}>{newsDate(issue.date)}</time><div><h2>{issue.title}</h2><p>{issue.intro}</p></div><small>{issue.stories.length} 条资讯 ↗</small></a></li>)}</ol></Base>
