---
import NewsEdition from '../../../components/NewsEdition.astro';
import {allNews,issues,paginateNews} from '../../../lib/news';
export function getStaticPaths(){const {pageCount}=paginateNews(allNews);return Array.from({length:Math.max(0,pageCount-1)},(_,i)=>({params:{page:String(i+2)},props:{page:i+2}}));}
const {page}=Astro.props;
---
<NewsEdition issue={issues[0]} scope="history" page={page}/>
