---
import Base from '../../layouts/Base.astro';
import {githubProjects,projectsCheckedAt,kancloud} from '../../lib/projects';
---
<Base title="作品 · 海波东"><h1 class="sr-only">作品</h1><div class="content-toolbar"><span>开源项目与技术写作</span><a href="https://github.com/ma1203580780" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div><div class="work-grid">
<article class="work-tile"><small>看云 · 知识专栏</small><h2><a href={kancloud.url} target="_blank" rel="noopener noreferrer">{kancloud.name}</a></h2><p>{kancloud.description}</p><div class="project-tags">{kancloud.tags.map(tag=><span>{tag}</span>)}</div><div class="discovery-links"><a href={kancloud.url} target="_blank" rel="noopener noreferrer">阅读专栏 ↗</a></div></article>
{githubProjects.map(repo=><article class="work-tile"><small>GitHub · {repo.fork?'Fork 仓库':'独立仓库'}</small><h2><a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name}</a></h2><p>{repo.name==='mind'?'个人博客与资讯阅读站，记录工程实践、收录公开资讯。':repo.description||'查看仓库中的代码与说明。'}</p><div class="project-tags"><a href={`${repo.url}/stargazers`} target="_blank" rel="noopener noreferrer" aria-label={`${repo.stars} Stars`}>☆ {repo.stars} Star</a><span>{repo.forks} Fork</span>{repo.language&&<span>{repo.language}</span>}<span>更新 {repo.updatedAt.slice(0,10)}</span></div><div class="discovery-links"><a href={repo.url} target="_blank" rel="noopener noreferrer">查看项目 ↗</a></div></article>)}
</div><p class="collection-note">GitHub 数据更新于 {projectsCheckedAt.slice(0,10)} · Star 为当前仓库数值。</p></Base>
