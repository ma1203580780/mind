---
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import projects from '../../data/projects.json';
import {statusLabels} from '../../lib/connections';
import '../../styles/project-gallery.css';

const presentations: Record<string, {title: string; summary: string; action: string}> = {
  mind: {title: 'mind', summary: '个人博客与资讯阅读站', action: '查看源码'},
  kancloud: {title: '看云', summary: '技术知识与实践文档', action: '阅读专栏'},
  'sre-course': {title: '0 基础吃透 SRE', summary: '慕课网 · 站点可靠性工程', action: '查看课程'},
};
const selected = projects.filter(({id}) => id in presentations);
---
<Base title="项目 · 海波东" description="mind、看云与慕课网 SRE 课程：开发、写作与可靠性工程实践。">
  <div class="lab-gallery">
    <h1 class="sr-only">项目</h1>
    <div class="lab-grid">
      {selected.map(project => {
        const presentation = presentations[project.id];
        return <article class="lab-project" id={project.id} data-project={project.id}>
          <a class="lab-project-link" href={project.github || project.url} target="_blank" rel="noopener noreferrer" aria-labelledby={`${project.id}-title ${project.id}-action`} data-connection-event={project.github ? 'project_github_click' : undefined}>
            <div class="lab-project-meta">
              <span class="lab-status" data-status={project.status}><i aria-hidden="true"></i>{statusLabels[project.status]}</span>
              <svg class="lab-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <ProjectVisual kind={project.id}/>
            <div class="lab-project-copy"><h2 id={`${project.id}-title`}>{presentation.title}</h2><p>{presentation.summary}</p></div>
            <div class="lab-project-action">
              <span id={`${project.id}-action`}>{presentation.action}</span>
              <span class="lab-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 17.5 17.5 6.5M6.5 6.5h11v11"/></svg></span>
            </div>
          </a>
        </article>;
      })}
    </div>
  </div>
</Base>
