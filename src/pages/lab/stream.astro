---
import Base from '../../layouts/Base.astro';import {path} from '../../site';
const cards=[{name:'理解任务',text:'把零散资讯整理为可阅读的卡片，保留标题、摘要与来源。'},{name:'组织内容',text:'先给出清晰的结构，让阅读者知道正在发生什么，再补充细节。'},{name:'回到证据',text:'每一条判断都应当能回到出处；实际体验与自动生成明确区分。'}];
---
<Base title="内容是怎样出现的？ · 交互实验"><header class="discovery-intro"><span class="eyebrow"><a href={path('lab/')}>← 作品与实验</a> <span>预设演示 · 不调用模型</span></span><h1>内容是怎样出现的？</h1><p>同样的内容、同样的生成速度。比较逐字出现与完成一张后再展示的阅读体验。</p></header><div class="reading-controls"><button id="play-stream">开始演示</button><button id="reset-stream">重置</button><label>速度 <select id="stream-speed"><option value="1">正常</option><option value="2">2 倍</option><option value="0.5">慢速</option></select></label><span id="stream-status" role="status">准备好了，点击开始。</span></div><div class="stream-comparison">{['逐字流式','逐卡片流式'].map((name,column)=><section class="stream-column" data-stream-column={column}><div class="stream-column-title"><h2>{name}</h2><small>{column===0?'先出现文字，内容逐渐完整':'卡片完整后，一次呈现'}</small></div><div class="stream-output">{cards.map((card,index)=><article class="stream-demo-card" data-stream-card={index} data-text={card.text}><span>0{index+1}</span><h3>{card.name}</h3><p>{card.text}</p></article>)}</div></section>)}</div><noscript><p>启用 JavaScript 可以控制演示；以上为完整示例内容。</p></noscript><details class="rule-panel"><summary>这个实验说明什么？</summary><p>逐字流式让内容尽早可见，但阅读中会持续变化；逐卡片展示可以保持内容结构稳定，但第一张卡片的等待更长。这里将两种方式的生成进度设为一致，仅比较呈现差异，不代表模型速度的实测。</p><p>真实产品应结合卡片结构与任务来选择。在复杂表格、参数、对比项中，内容完整性尤其重要。开启系统「减少动态效果」时，不播放进入动效。</p></details><div class="discovery-links"><a href={path('topics/product-experience/')}>继续探索交互专题 ↗</a></div></Base>
<style>.stream-comparison{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:24px 0}.stream-column{border:1px solid var(--line);border-radius:24px;background:var(--surface);padding:23px;min-width:0}.stream-column-title h2{font-size:17px;font-weight:550;margin:0 0 3px}.stream-column-title small{font-size:11px;color:var(--muted)}.stream-output{margin-top:24px;min-height:440px}.stream-demo-card{background:var(--paper);border:1px solid var(--line);border-radius:17px;box-shadow:var(--shadow);padding:18px;margin:12px 0;transition:opacity .18s,transform .18s}.stream-demo-card h3{font-size:14px;font-weight:550;display:inline;margin-left:12px}.stream-demo-card>span{font-size:10px;color:var(--muted)}.stream-demo-card p{font-size:13px;line-height:1.85;margin:12px 0 0;min-height:72px}.stream-demo-card.pending{visibility:hidden}.stream-demo-card.arriving{animation:arrive .2s ease-out}@keyframes arrive{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}#stream-status{font-size:12px;color:var(--muted)}@media(max-width:600px){.stream-comparison{gap:10px}.stream-column{padding:13px 10px;border-radius:18px}.stream-column-title h2{font-size:15px}.stream-column-title small{font-size:10px}.stream-demo-card{padding:12px 10px}.stream-demo-card h3{margin-left:5px;font-size:12px}.stream-demo-card p{font-size:12px;min-height:120px}.stream-output{min-height:620px}}</style>
<script>
import {track} from '../../scripts/analytics';
const columns=[...document.querySelectorAll<HTMLElement>('[data-stream-column]')].map(c=>[...c.querySelectorAll<HTMLElement>('[data-stream-card]')]);const texts=columns[0].map(c=>Array.from(c.dataset.text!));const total=texts.reduce((n,t)=>n+t.length,0);const play=document.querySelector<HTMLButtonElement>('#play-stream')!,reset=document.querySelector<HTMLButtonElement>('#reset-stream')!,speed=document.querySelector<HTMLSelectElement>('#stream-speed')!,status=document.querySelector('#stream-status')!;let progress=0,running=false,frame=0,last=0;
function draw(){let offset=0;for(let i=0;i<texts.length;i++){const count=Math.max(0,Math.min(texts[i].length,Math.floor(progress-offset)));for(let col=0;col<2;col++){const card=columns[col][i],visible=col===0?count>0:count===texts[i].length;const wasHidden=card.classList.contains('pending');card.classList.toggle('pending',!visible);if(visible&&wasHidden){card.classList.remove('arriving');void card.offsetWidth;card.classList.add('arriving');}card.querySelector('p')!.textContent=col===0?texts[i].slice(0,count).join(''):texts[i].join('');}offset+=texts[i].length;}status.textContent=progress>=total?'演示完成，可以重放。':running?`正在呈现 · ${Math.floor(progress/total*100)}%`:progress?'已暂停':'准备好了，点击开始。';play.textContent=progress>=total?'重新播放':running?'暂停':'开始演示';}
function tick(now:number){if(!running)return;const delta=last?Math.min((now-last)/1000,.1):0;last=now;progress=Math.min(total,progress+delta*12*Number(speed.value));if(progress>=total)running=false;draw();if(running)frame=requestAnimationFrame(tick);}
play.addEventListener('click',()=>{running=!running;if(progress>=total){progress=0;running=true;}cancelAnimationFrame(frame);last=0;if(running){track('lab_interact',{mode:'stream'});frame=requestAnimationFrame(tick);}draw();});reset.addEventListener('click',()=>{cancelAnimationFrame(frame);running=false;progress=0;last=0;draw();});document.addEventListener('visibilitychange',()=>{if(document.hidden&&running){running=false;cancelAnimationFrame(frame);draw();}});draw();
</script>
