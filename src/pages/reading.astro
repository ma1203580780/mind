---
import Base from '../layouts/Base.astro';import {path} from '../site';
---
<Base title="我的阅读 · 海波东" noindex><h1 class="sr-only">我的阅读</h1><div id="reading-browser" data-index={path('search-index.json')} data-mode="saved"><div class="reading-controls" role="group" aria-label="阅读记录"><button data-reading-tab="saved" aria-pressed="true">我的收藏</button><button data-reading-tab="read" aria-pressed="false">已读记录</button><button id="clear-reading">清除本地记录</button></div><label class="searchbox"><span class="sr-only">搜索阅读记录</span><input id="query" type="search" placeholder="在收藏和已读中查找…"/></label><p id="search-status" class="collection-note" role="status">正在加载…</p><button id="retry-index" class="quiet-button" hidden>重新加载</button><section id="results" class="note-feed search-results" aria-label="阅读记录"></section><nav id="result-pages" class="result-footer" aria-label="阅读记录分页" hidden><button id="previous-page">上一页</button><span id="page-label"></span><button id="next-page">下一页</button></nav></div><p class="collection-note">仅保存在当前浏览器，不上传、不跨设备同步。</p><noscript><p>本地收藏与已读功能需要 JavaScript。</p></noscript></Base>
<script>import '../scripts/reading-browser';</script>
