---
import Base from '../layouts/Base.astro';import {path} from '../site';
const feeds=[{name:'博客',url:'rss.xml',description:'作者原创文章。'},{name:'资讯',url:'news/rss.xml',description:'外部采集内容，保留来源与原文地址。'}];
---
<Base title="订阅更新 · 海波东"><header class="page-heading"><h1>订阅更新</h1><p>复制下面的地址，添加到你的 RSS 阅读器；之后的新内容会自动送达。</p></header>{feeds.map(feed=><section class="subscribe-feed"><h2>{feed.name}</h2><p>{feed.description}</p><label><span class="sr-only">{feed.name}订阅地址</span><input readonly value={new URL(path(feed.url),Astro.site).href}/></label><div class="discovery-links"><button type="button" class="quiet-button" data-copy-feed>复制订阅地址</button><a href={path(feed.url)} data-track="subscribe" data-feed={feed.url}>打开 RSS ↗</a></div></section>)}<p id="feed-copy-status" class="collection-note" role="status"></p><p class="collection-note">支持 RSS 2.0，阅读器也可通过本站首页自动发现订阅。</p></Base>
<script>
import {track} from '../scripts/analytics';
import {onPageLoad} from '../scripts/page-lifecycle';
onPageLoad((signal,onCleanup)=>{
if(!document.querySelector('.subscribe-feed'))return;
document.querySelectorAll<HTMLButtonElement>('[data-copy-feed]').forEach(b=>b.addEventListener('click',async()=>{const input=b.closest('section')!.querySelector('input')!;const status=document.querySelector('#feed-copy-status')!;try{await navigator.clipboard.writeText(input.value);status.textContent='订阅地址已复制，可以粘贴到阅读器。';track('subscribe',{feed:new URL(input.value).pathname});}catch{input.select();status.textContent='已选中地址，请手动复制。';}}));
});
</script>
