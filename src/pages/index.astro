---
import NewsEdition from '../components/NewsEdition.astro';
import {path,getPosts,dateLabel,reading} from '../site';import {issues} from '../lib/news';
const recent=(await getPosts()).filter(p=>!p.data.demo).slice(0,3);
---
<NewsEdition issue={issues[0]} scope="history" featured>
<section class="recent-writing" aria-labelledby="recent-title"><div class="editorial-heading"><h2 id="recent-title">最近写的</h2><a href={path('archive/')}>全部博客 →</a></div><div class="text-entries">{recent.map(post=><a href={path(`posts/${post.id}/`)}><div><h3>{post.data.title}</h3><small>{post.data.category} · {reading(post.body)} 分钟{post.data.authorship==='assisted'?' · AI 辅助记录':''}</small></div><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span aria-hidden="true">→</span></a>)}</div>{recent.length===0&&<p class="muted">新文章正在整理，先看看正在构建的项目。</p>}</section>
</NewsEdition>
