---
import Base from '../layouts/Base.astro';import SourceCard from '../components/SourceCard.astro';
import {path} from '../site';import {allNews} from '../lib/news';import {readingCandidates,latestNewsDate} from '../lib/discovery';
const candidates=readingCandidates(allNews,latestNewsDate,5);
---
<Base title="精选资讯 · 海波东"><h1 class="sr-only">精选资讯</h1><div class="content-toolbar"><span>{latestNewsDate} · {candidates.length} 条阅读候选</span><div class="toolbar-links"><details><summary>筛选规则 ⌄</summary><div><p>近七天、摘要完整、中译可用，每个来源最多一条。排除版本日志，优先覆盖不同板块。</p><p>自动筛选，不代表作者推荐；原文与机译均保留出处。</p></div></details><a href={path('subscribe/')}>订阅 ↗</a></div></div><section class="note-feed" aria-label="精选资讯">{candidates.map(story=><SourceCard story={story} issue={story.issueDate}/>)}</section><div class="discovery-links"><a href={path('news/')}>查看全部 {allNews.length} 条资讯 ↗</a><a href={path('news/sources/')}>信息源与采集状态 ↗</a></div></Base>
