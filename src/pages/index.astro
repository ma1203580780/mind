---
import Base from '../layouts/Base.astro';import SourceCard from '../components/SourceCard.astro';
import {path} from '../site';import {allNews} from '../lib/news';import {readingCandidates,latestNewsDate} from '../lib/discovery';
const candidates=readingCandidates(allNews,latestNewsDate,5);
---
<Base title="精选资讯 · 海波东"><h1 class="sr-only">精选资讯</h1><section class="note-feed" aria-label="精选资讯">{candidates.map(story=><SourceCard story={story} issue={story.issueDate}/>)}</section><div class="discovery-links"><a href={path('news/')}>查看全部 {allNews.length} 条资讯 ↗</a><a href={path('news/sources/')}>信息源与采集状态 ↗</a></div></Base>
