---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SourceCard from '../components/SourceCard.astro';
import {getPosts,path} from '../site';
import {issues,newsDate} from '../lib/news';
const posts=await getPosts();const issue=issues[0];
const stories=[...issue.stories].sort((a,b)=>Number(!!b.image)-Number(!!a.image)).slice(0,12);
const feed=[];for(let i=0;i<Math.max(posts.length,stories.length);i++){if(stories[i])feed.push({kind:'source',value:stories[i]});if(posts[i])feed.push({kind:'note',value:posts[i]});}
---
<Base>
<header class="notebook-intro"><div class="notebook-caption"><span>海波东 / 个人笔记</span><a href={path('about/')}>关于我 ↗</a></div><h1>把值得想的，留下来。</h1><p>AI 工程、交互设计，和正在做的事。</p><div class="notebook-links"><a href={path('archive/')}>我的笔记</a><span>·</span><a href={path('news/')}>新闻与来源摘读</a><span>·</span><a href={path('rss.xml')}>RSS 订阅 ↗</a></div></header>
<section class="notebook-stream" aria-label="笔记与一手资料"><div class="stream-toolbar"><div class="filters stream-filters" role="group" aria-label="筛选内容类型"><button class="selected" data-kind="all" aria-pressed="true">全部</button><button data-kind="note" aria-pressed="false">笔记 <small>{posts.length}</small></button><button data-kind="source" aria-pressed="false">来源摘读 <small>{stories.length}</small></button></div><a href={path('news/')}>{newsDate(issue.date).slice(5)} 摘读 ↗</a></div><p class="stream-status sr-only" aria-live="polite" id="feed-status">共 {feed.length} 条内容</p><div class="note-feed home-feed" id="posts">{feed.map(item=><div class="feed-item" data-feed-kind={item.kind}>{item.kind==='note'?<PostCard post={item.value}/>:<SourceCard story={item.value} issue={issue.date}/>}</div>)}</div></section>
<section class="notebook-bottom"><div><span class="eyebrow">继续阅读</span><h2>沿着兴趣，往深处走。</h2></div><div><a href={path('tags/AI工程/')}>AI 工程 ↗</a><a href={path('tags/交互设计/')}>交互设计 ↗</a><a href={path('tags/创作/')}>创作实践 ↗</a><a href={path('news/archive/')}>往期新闻 ↗</a></div></section>
</Base>
<script>
const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-kind]')];filters.forEach(button=>button.addEventListener('click',()=>{filters.forEach(b=>{b.classList.toggle('selected',b===button);b.setAttribute('aria-pressed',String(b===button))});let count=0;document.querySelectorAll<HTMLElement>('[data-feed-kind]').forEach(el=>{el.hidden=button.dataset.kind!=='all'&&el.dataset.feedKind!==button.dataset.kind;if(!el.hidden)count++});document.querySelector('#feed-status')!.textContent=`共 ${count} 条内容`}));
</script>
