---
import Base from '../../layouts/Base.astro';import SourceCard from '../../components/SourceCard.astro';import PostCard from '../../components/PostCard.astro';import {topics,storiesForTopic} from '../../lib/discovery';import {getPosts,path} from '../../site';
export function getStaticPaths(){return topics.map(topic=>({params:{slug:topic.slug},props:{topic}}));}
const {topic}=Astro.props;const sources=storiesForTopic(topic);const posts=(await getPosts()).filter(p=>!p.data.demo&&p.data.tags.some(tag=>topic.tags.includes(tag)));
---
<Base title={`${topic.name} · 海波东`} description={topic.intro}><h1 class="sr-only">{topic.name}</h1><div class="content-toolbar"><span>{topic.intro}</span><a href={path('lab/')}>相关项目 ↗</a></div>{posts.length>0&&<section class="collection-section"><div class="section-title"><h2>本站记录</h2></div><div class="blog-grid">{posts.map(post=><PostCard post={post}/>)}</div></section>}<section class="collection-section"><div class="section-title"><h2>近期来源资料</h2><span class="eyebrow">{sources.length} 条历史资料</span></div><p class="collection-note">按发布时间倒序展示最近 12 条；在下方选择分类可浏览完整历史。</p><div class="note-feed">{sources.slice(0,12).map(story=><SourceCard story={story} issue={story.issueDate}/>)}</div><div class="discovery-links">{topic.categories.map(category=><a href={path(`news/filter/history/all/${encodeURIComponent(category)}/1/`)}>{category} · 全部历史 ↗</a>)}</div></section></Base>
