---
import Base from '../../layouts/Base.astro';import SourceCard from '../../components/SourceCard.astro';import PostCard from '../../components/PostCard.astro';import {topics,storiesForTopic} from '../../lib/discovery';import {getPosts,path} from '../../site';
export function getStaticPaths(){return topics.map(topic=>({params:{slug:topic.slug},props:{topic}}));}
const {topic}=Astro.props;const sources=storiesForTopic(topic);const posts=(await getPosts()).filter(p=>!p.data.demo&&p.data.tags.some(tag=>topic.tags.includes(tag)));
---
<Base title={`${topic.name} · 海波东`} description={topic.intro}><header class="discovery-intro"><span class="eyebrow"><a href={path('topics/')}>← 持续专题</a><span>持续整理</span></span><h1>{topic.name}</h1><p>{topic.intro}</p></header><div class="work-feature"><div><span class="eyebrow">从一个具体问题开始</span><h2>{topic.question}</h2><p>{topic.slug==='product-experience'?'在交互实验中比较两种内容出现方式，再回看它们的取舍。':'从新闻站的公开实现出发，查看数据怎样成为一个可持续运行的产品。'}</p></div><a href={path(topic.slug==='product-experience'?'lab/stream/':'posts/building-mind/')} aria-label="打开专题入门案例">↗</a></div>{posts.length>0&&<section class="collection-section"><div class="section-title"><h2>本站记录</h2></div><div class="note-feed">{posts.map(post=><PostCard post={post}/>)}</div></section>}<section class="collection-section"><div class="section-title"><h2>近期来源资料</h2><span class="eyebrow">{sources.length} 条历史资料</span></div><p class="collection-note">按发布时间倒序展示最近 12 条；在下方选择分类可浏览完整历史。</p><div class="note-feed">{sources.slice(0,12).map(story=><SourceCard story={story} issue={story.issueDate}/>)}</div><div class="discovery-links">{topic.categories.map(category=><a href={path(`news/filter/history/all/${encodeURIComponent(category)}/1/`)}>{category} · 全部历史 ↗</a>)}</div></section></Base>
