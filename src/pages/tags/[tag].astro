---
import Base from '../../layouts/Base.astro';import PostCard from '../../components/PostCard.astro';import {getPosts} from '../../site';
export async function getStaticPaths(){const posts=await getPosts();return [...new Set(posts.flatMap(p=>p.data.tags))].map(tag=>({params:{tag},props:{tag,posts:posts.filter(p=>p.data.tags.includes(tag))}}))};const {tag,posts}=Astro.props;
---
<Base title={`${tag} · 海波东`}><div class="content-toolbar"><h1>{tag}</h1><span>{posts.length} 篇博客</span></div><section class="archive blog-grid">{posts.map((p,i)=><PostCard post={p} index={i}/>)}</section></Base>
