{
  "name": "haibodong-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run news:validate && astro build",
    "preview": "astro preview --host 0.0.0.0",
