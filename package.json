{
  "name": "haibodong-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run news:validate && npm run reading:check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "news:validate": "node scripts/validate-news.mjs",
    "test:news": "node --test scripts/validate-news.test.mjs scripts/news-feed.test.mjs",
    "write": "astro dev --host 127.0.0.1 --port 4321",
    "test:writing": "node --test scripts/remark-uploads.test.mjs",
    "test:v2": "node --test scripts/v2.test.mjs",
    "reading:build": "python3 scripts/build-reading-articles.py",
    "reading:check": "node scripts/check-reading-articles.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.17",
    "astro": "7.3.5"
  }
}
